  {
   "identifier": "rename",
   "description": "More refined handling in case the new name collides with another ID's name",
   "use_self": true,
   "use_self_type": false,
   "is_registered": false,
   "is_registered_optional": false,
   "params": [
    {
     "identifier": "name",
     "name": "",
     "description": "New name to rename the ID to, if empty will re-use the current ID name",
     "type": "STRING",
     "subtype": "NONE",
     "unit": "NONE",
     "default": "",
     "length_max": 64,
     "flags": [
      "REQUIRED",
      "NEVER_NULL"
     ]
    },
    {
     "identifier": "mode",
     "name": "",
     "description": "How to handle name collision, in case the requested new name is already used by another ID of the same type",
     "type": "ENUM",
     "subtype": "NONE",
     "unit": "NONE",
     "items": [
      {
       "identifier": "NEVER",
       "name": "Never Rename",
       "description": "Never rename an existing ID whose name would conflict, the currently renamed ID will get a numeric suffix appended to its new name",
       "icon": "NONE",
       "value": 0
      },
      {
       "identifier": "ALWAYS",
       "name": "Always Rename",
       "description": "Always rename an existing ID whose name would conflict, ensuring that the currently renamed ID will get requested name",
       "icon": "NONE",
       "value": 1
      },
      {
       "identifier": "SAME_ROOT",
       "name": "Rename If Same Root",
       "description": "Only rename an existing ID whose name would conflict if its name root (everything besides the numerical suffix) is the same as the existing name of the currently renamed ID",
       "icon": "NONE",
       "value": 2
      }
     ],
     "default": "NEVER",
     "flags": [
      "ANIMATABLE"
     ]
    }
   ],
   "returns": [
    {
     "identifier": "id_rename_result",
     "name": "",
     "description": "How did the renaming of the data-block went on",
     "type": "ENUM",
     "subtype": "NONE",
     "unit": "NONE",
     "items": [
      {
       "identifier": "UNCHANGED",
       "name": "Unchanged",
       "description": "The ID was not renamed, e.g. because it is already named as requested",
       "icon": "NONE",
       "value": 0
      },
      {
       "identifier": "UNCHANGED_COLLISION",
       "name": "Unchanged Due to Collision",
       "description": "The ID was not renamed, because requested name would have collided with another existing ID's name, and the automatically adjusted name was the same as the current ID's name",
       "icon": "NONE",
       "value": 1
      },
      {
       "identifier": "RENAMED_NO_COLLISION",
       "name": "Renamed Without Collision",
       "description": "The ID was renamed as requested, without creating any name collision",
       "icon": "NONE",
       "value": 2
      },
      {
       "identifier": "RENAMED_COLLISION_ADJUSTED",
       "name": "Renamed With Collision",
       "description": "The ID was renamed with adjustment of the requested name, to avoid a name collision",
       "icon": "NONE",
       "value": 3
      },
      {
       "identifier": "RENAMED_COLLISION_FORCED",
       "name": "Renamed Enforced With Collision",
       "description": "The ID was renamed as requested, also renaming another ID to avoid a name collision",
       "icon": "NONE",
       "value": 4
      }
     ],
     "default": "UNCHANGED",
     "flags": [
      "OUTPUT",
      "ANIMATABLE"
     ]
    }
   ]
  },
