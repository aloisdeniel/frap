     "type": "POINTER",
     "subtype": "NONE",
     "unit": "NONE",
     "fixed_type": "Depsgraph",
     "is_id": false,
     "flags": [
      "READONLY"
     ]
    }
   ],
   "returns": [
    {
     "identifier": "mesh",
     "name": "",
     "description": "Mesh created from object, remove it if it is only used for export",
     "type": "POINTER",
     "subtype": "NONE",
     "unit": "NONE",
     "fixed_type": "Mesh",
     "is_id": true,
     "flags": [
      "READONLY",
      "OUTPUT"
     ]
    }
   ]
  },
  {
