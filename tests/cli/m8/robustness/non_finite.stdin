bpy.data.objects['Cube'].data.vertices[0].co = (float('nan'), 0, 0)
bpy.ops.object.mode_set(mode='EDIT')
bpy.ops.mesh.select_all(action='SELECT')
bpy.ops.uv.unwrap(method='CONFORMAL')
bpy.ops.uv.unwrap(method='ANGLE_BASED')
bpy.ops.uv.unwrap(method='MINIMUM_STRETCH', iterations=2)
bpy.ops.uv.minimize_stretch(iterations=2)
bpy.ops.mesh.intersect(mode='SELECT', solver='EXACT')
bpy.ops.mesh.intersect(mode='SELECT_UNSELECT', solver='EXACT')
bpy.ops.mesh.intersect_boolean(solver='EXACT')
bpy.ops.object.mode_set(mode='OBJECT')
bpy.ops.mesh.primitive_cube_add(size=1, location=(0.5, 0.5, 0.5))
bpy.context.view_layer.objects.active = bpy.data.objects['Cube']
bpy.ops.object.modifier_add(type='BOOLEAN')
bpy.context.object.modifiers['Boolean'].object = bpy.data.objects['Cube.001']
bpy.context.object.modifiers['Boolean'].solver = 'EXACT'
print(bpy.context.object.evaluated_get(bpy.context.evaluated_depsgraph_get()).data.vertices[0].co)
bpy.ops.object.modifier_apply(modifier='Boolean')
bpy.ops.mesh.primitive_monkey_add()
bpy.ops.object.mode_set(mode='EDIT')
bpy.ops.mesh.select_all(action='SELECT')
bpy.ops.mesh.face_make_planar(repeat=100, factor=10)
bpy.ops.uv.unwrap(method='ANGLE_BASED')
bpy.ops.uv.unwrap(method='CONFORMAL')
bpy.ops.uv.unwrap(method='MINIMUM_STRETCH', iterations=2)
