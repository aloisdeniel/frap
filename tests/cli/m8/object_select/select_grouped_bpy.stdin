bpy.ops.object.select_grouped.poll()
bpy.ops.object.select_grouped(type='KEYINGSET')
bpy.ops.object.select_grouped(type='LIGHT_TYPE')
bpy.ops.object.select_grouped(type='CHILDREN', extend=True)
bpy.data.collections.new('Other')
bpy.data.collections['Other'].objects.link(bpy.data.objects['Cube'])
bpy.ops.object.select_grouped(type='COLLECTION')
bpy.ops.object.select_same_collection(collection='Other')
bpy.context.view_layer.objects.active = None
bpy.ops.object.select_grouped()
bpy.ops.object.select_linked()
bpy.ops.object.select_hierarchy()
bpy.ops.object.collection_objects_select()
bpy.ops.object.mode_set_with_submode(mode='EDIT')
bpy.ops.object.hide_collection(collection_index=7)
