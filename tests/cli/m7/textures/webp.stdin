bpy.ops.image.new(name='Grid', width=8, height=8, generated_type='UV_GRID')
bpy.data.materials['Material'].node_tree.nodes.new('ShaderNodeTexImage')
bpy.data.materials['Material'].node_tree.nodes['Image Texture'].image = bpy.data.images['Grid']
bpy.data.materials['Material'].node_tree.links.new(bpy.data.materials['Material'].node_tree.nodes['Image Texture'].outputs['Color'], bpy.data.materials['Material'].node_tree.nodes['Principled BSDF'].inputs['Base Color'])
bpy.ops.export_scene.gltf(filepath='webp.glb', export_image_format='WEBP', export_image_quality=100)
bpy.ops.export_scene.gltf(filepath='both.glb', export_image_add_webp=True)
bpy.ops.wm.read_homefile(use_empty=True)
bpy.ops.import_scene.gltf(filepath='webp.glb')
bpy.data.images['Grid'].file_format
bpy.data.images['Grid'].size
bpy.ops.import_scene.gltf(filepath='both.glb', import_webp_texture=False)
bpy.data.images['Grid.001'].file_format
bpy.ops.import_scene.gltf(filepath='both.glb', import_webp_texture=True)
bpy.data.images['Grid.002'].file_format
