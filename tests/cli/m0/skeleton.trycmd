{"seq":3,"line":3,"kind":"set","ok":true,"status":"FINISHED","path":"bpy.data.objects['Cube'].location","value":[1,2,3],"reports":[],"changes":{"added":[],"removed":[],"modified":["bpy.data.objects['Cube']"],"renamed":[]},"context":{"mode":"OBJECT","active_object":"Cube.002","selected_objects":["Cube.002"],"frame_current":1},"hints":[]}
{"seq":4,"line":4,"kind":"get","ok":true,"status":"FINISHED","path":"bpy.data.objects['Cube'].location","value":[1,2,3],"rna":{"type":"FLOAT","subtype":"TRANSLATION","array":[3],"math":"Vector"},"reports":[],"context":{"mode":"OBJECT","active_object":"Cube.002","selected_objects":["Cube.002"],"frame_current":1},"hints":[]}
{"seq":5,"line":5,"kind":"op","op":"export_scene.gltf","ok":true,"status":"FINISHED","reports":[],"result":{"filepath":"out/m0.glb","bytes":4808,"nodes":3,"meshes":3,"extensions_used":[]},"changes":{"added":[],"removed":[],"modified":[],"renamed":[]},"context":{"mode":"OBJECT","active_object":"Cube.002","selected_objects":["Cube.002"],"frame_current":1},"hints":[]}
