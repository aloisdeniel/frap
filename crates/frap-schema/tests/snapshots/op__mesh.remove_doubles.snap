source: crates/frap-schema/tests/describe_ops.rs
---
{
  "idname": "mesh.remove_doubles",
  "bl_idname": "MESH_OT_remove_doubles",
  "label": "Merge by Distance",
  "description": "Merge vertices based on their proximity",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "threshold",
      "name": "Merge Distance",
      "description": "Maximum distance between elements to merge",
      "type": "FLOAT",
      "subtype": "DISTANCE",
      "unit": "LENGTH",
      "array": null,
      "default": 0.0001,
      "hard_min": 0.000001,
      "hard_max": 50,
      "soft_min": 0.00001,
      "soft_max": 10,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_centroid",
      "name": "Centroid Merge",
      "description": "Move vertices to the centroid of the duplicate cluster, otherwise the vertex closest to the centroid is used.",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_unselected",
      "name": "Unselected",
      "description": "Merge selected to other unselected vertices",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_sharp_edge_from_normals",
      "name": "Sharp Edges",
      "description": "Calculate sharp edges using custom normal data (when available)",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M2",
    "extension": false,
    "notes": [
      "INFO report 'Removed N vertices' ('Removed 1 vertex') and result.removed = N, summed over the edit meshes",
      "clusters are not chained: a vertex merges into the cluster target found first (kd-tree order), as in Blender",
      "use_sharp_edge_from_normals has no effect (no custom normals in Edit Mode yet)"
    ]
  }
}
