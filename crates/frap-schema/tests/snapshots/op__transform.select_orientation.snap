{
  "idname": "transform.select_orientation",
  "bl_idname": "TRANSFORM_OT_select_orientation",
  "label": "Select Orientation",
  "description": "Select transformation orientation",
  "bl_options": [
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "YYYYY"
    }
  },
  "properties": [
    {
      "identifier": "orientation",
      "name": "Orientation",
      "description": "Transformation orientation",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "GLOBAL",
      "enum_items": [
        {
          "identifier": "GLOBAL",
          "name": "Global",
          "description": "Align the transformation axes to world space",
          "value": 0
        },
        {
          "identifier": "LOCAL",
          "name": "Local",
          "description": "Align the transformation axes to the selected objects' local space",
          "value": 1
        },
        {
          "identifier": "NORMAL",
          "name": "Normal",
          "description": "Align the transformation axes to average normal of selected elements (bone Y axis for pose mode)",
          "value": 2
        },
        {
          "identifier": "GIMBAL",
          "name": "Gimbal",
          "description": "Align each axis to the Euler rotation axis as used for input",
          "value": 4
        },
        {
          "identifier": "VIEW",
          "name": "View",
          "description": "Align the transformation axes to the window",
          "value": 3
        },
        {
          "identifier": "CURSOR",
          "name": "Cursor",
          "description": "Align the transformation axes to the 3D cursor",
          "value": 5
        },
        {
          "identifier": "PARENT",
          "name": "Parent",
          "description": "Align the transformation axes to the object's parent space",
          "value": 6
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": "TRANSFORM_OT_select_orientation.orientation",
      "context_rule": "items depend on the context in Blender (TRANSFORM_OT_select_orientation.orientation); frap narrows them to the live context, enum_items is the superset",
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE",
        "DYNAMIC_ENUM"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "partial",
    "support_note": "scene.transform_orientation_slots is not bound: the selected orientation is seen by the transforms (orient_type unset) only",
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": []
  }
}
