{
  "idname": "mesh.convex_hull",
  "bl_idname": "MESH_OT_convex_hull",
  "label": "Convex Hull",
  "description": "Enclose selected vertices in a convex polyhedron",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "delete_unused",
      "name": "Delete Unused",
      "description": "Delete selected elements that are not used by the hull",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_existing_faces",
      "name": "Use Existing Faces",
      "description": "Skip hull triangles that are covered by a pre-existing face",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "make_holes",
      "name": "Make Holes",
      "description": "Delete selected faces that are used by the hull",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "join_triangles",
      "name": "Join Triangles",
      "description": "Merge adjacent triangles into quads",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "face_threshold",
      "name": "Max Face Angle",
      "description": "Face angle limit",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 0.6981317,
      "hard_min": 0,
      "hard_max": 3.1415927,
      "soft_min": 0,
      "soft_max": 3.1415927,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "shape_threshold",
      "name": "Max Shape Angle",
      "description": "Shape angle limit",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 0.6981317,
      "hard_min": 0,
      "hard_max": 3.1415927,
      "soft_min": 0,
      "soft_max": 3.1415927,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "topology_influence",
      "name": "Topology Influence",
      "description": "How much to prioritize regular grids of quads as well as quads that touch existing quads",
      "type": "FLOAT",
      "subtype": "FACTOR",
      "unit": "NONE",
      "array": null,
      "default": 0,
      "hard_min": 0,
      "hard_max": 2,
      "soft_min": 0,
      "soft_max": 2,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
