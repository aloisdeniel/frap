{
  "idname": "object.shade_auto_smooth",
  "bl_idname": "OBJECT_OT_shade_auto_smooth",
  "label": "Shade Auto Smooth",
  "description": "Add modifier to automatically set the sharpness of mesh edges based on the angle between the neighboring faces",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "SCENE_EDITABLE",
      "MODE_OBJECT",
      "ACTIVE_EDITABLE"
    ],
    "text": "requires an editable scene, Object Mode (bpy.ops.object.mode_set(mode='OBJECT')), the active object is editable (not linked)",
    "matrix": {
      "plain": "YYNYN",
      "view3d": "YYNYN"
    }
  },
  "properties": [
    {
      "identifier": "use_auto_smooth",
      "name": "Auto Smooth",
      "description": "Add modifier to set edge sharpness automatically",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "angle",
      "name": "Angle",
      "description": "Maximum angle between face normals that will be considered as smooth",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 0.5235988,
      "hard_min": 0,
      "hard_max": 3.1415927,
      "soft_min": 0,
      "soft_max": 3.1415927,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M4",
    "extension": false,
    "notes": [
      "the Essentials library path is <frap>/datafiles/assets/nodes/geometry_nodes_essentials.blend (Blender: its installation)"
    ]
  }
}
