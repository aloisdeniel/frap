          "name": "View",
          "description": "Align the new object to the view",
          "value": 1
        },
        {
          "identifier": "CURSOR",
          "name": "3D Cursor",
          "description": "Use the 3D cursor orientation for the new object",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "location",
      "name": "Location",
      "description": "Location for the newly added object",
      "type": "FLOAT",
      "subtype": "XYZ_LENGTH",
      "unit": "LENGTH",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -1000000000000,
      "hard_max": 1000000000000,
      "soft_min": -1000,
      "soft_max": 1000,
      "precision": 3,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": "unset: the 3D cursor location (scene.cursor.location)",
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "rotation",
      "name": "Rotation",
      "description": "Rotation for the newly added object",
      "type": "FLOAT",
      "subtype": "EULER",
      "unit": "ROTATION (radians)",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -1000000000000,
      "hard_max": 1000000000000,
      "soft_min": -6.2831855,
      "soft_max": 6.2831855,
      "precision": 3,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": "unset: from align (WORLD: no rotation, VIEW: the 3D view rotation, CURSOR: the 3D cursor rotation); an explicit rotation always wins",
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "scale",
      "name": "Scale",
      "description": "Scale for the newly added object",
      "type": "FLOAT",
      "subtype": "XYZ_LENGTH",
      "unit": "LENGTH",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -1000000000000,
      "hard_max": 1000000000000,
      "soft_min": -1000,
      "soft_max": 1000,
      "precision": 3,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "partial",
    "support_note": "types with data in frap: MESH, CAMERA, LIGHT, ARMATURE, EMPTY, POINTCLOUD; the others answer OP_NOT_IMPLEMENTED naming the type",
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": [
      "radius scales the empty display size, the camera display size and the light sizes (BKE_object_obdata_size_init)"
    ]
  }
}
