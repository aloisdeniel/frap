    {
      "identifier": "action",
      "name": "Action",
      "description": "Selection action to execute",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "TOGGLE",
      "enum_items": [
        {
          "identifier": "DISABLE",
          "name": "Disable",
          "description": "Disable the selection mode",
          "value": 0
        },
        {
          "identifier": "ENABLE",
          "name": "Enable",
          "description": "Enable the selection mode",
          "value": 1
        },
        {
          "identifier": "TOGGLE",
          "name": "Toggle",
          "description": "Toggle the selection mode",
          "value": 2
