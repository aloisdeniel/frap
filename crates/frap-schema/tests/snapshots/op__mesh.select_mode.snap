          "name": "Vertex",
          "description": "Vertex selection mode",
          "value": 1
        },
        {
          "identifier": "EDGE",
          "name": "Edge",
          "description": "Edge selection mode",
          "value": 2
        },
        {
          "identifier": "FACE",
          "name": "Face",
          "description": "Face selection mode",
          "value": 4
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
