{
  "idname": "mesh.loop_select",
  "bl_idname": "MESH_OT_loop_select",
  "label": "Loop Select",
  "description": "Select a loop of connected edges",
  "bl_options": [
    "DEPENDS_ON_CURSOR",
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "delimit_edge_loop",
      "name": "Delimit",
      "description": "Delimit edge loop selection",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": [
        "NGONS",
        "OUTER_CORNERS"
      ],
      "enum_items": [
        {
          "identifier": "SEAM",
          "name": "Seam",
          "description": "Delimit edge loop selection at seams",
          "value": 16
        },
        {
          "identifier": "SHARP",
          "name": "Sharp",
          "description": "Delimit edge loop selection at sharp edges",
          "value": 32
        },
        {
          "identifier": "NGONS",
          "name": "N-gons",
          "description": "Stop boundary selection at n-gons",
          "value": 4
        },
        {
          "identifier": "INNER_CORNERS",
          "name": "Inner Corners",
          "description": "Stop boundary selection at vertices with more than three edges",
          "value": 1
        },
        {
          "identifier": "OUTER_CORNERS",
          "name": "Outer Corners",
          "description": "Stop boundary selection at vertices with two edges when they share a face that is not an n-gon",
          "value": 2
        }
      ],
      "is_enum_flag": true,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
