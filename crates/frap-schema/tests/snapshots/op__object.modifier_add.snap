{
  "idname": "object.modifier_add",
  "bl_idname": "OBJECT_OT_modifier_add",
  "label": "Add Modifier",
  "description": "Add a procedural operation/effect to the active object",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "ACTIVE_OBJECT",
      "ACTIVE_EDITABLE"
    ],
    "text": "requires an active object (bpy.context.view_layer.objects.active), the active object is editable (not linked)",
    "matrix": {
      "plain": "YNYYY",
      "view3d": "YNYYY"
    }
  },
