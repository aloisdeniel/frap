{
  "idname": "mesh.tris_convert_to_quads",
  "bl_idname": "MESH_OT_tris_convert_to_quads",
  "label": "Triangles to Quads",
  "description": "Merge triangles into four sided polygons where possible",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "face_threshold",
      "name": "Max Face Angle",
      "description": "Face angle limit",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 0.6981317,
      "hard_min": 0,
      "hard_max": 3.1415927,
      "soft_min": 0,
      "soft_max": 3.1415927,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "shape_threshold",
      "name": "Max Shape Angle",
      "description": "Shape angle limit",
      "type": "FLOAT",
