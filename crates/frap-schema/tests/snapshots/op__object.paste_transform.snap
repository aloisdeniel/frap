          "description": "",
          "value": 2
        },
        {
          "identifier": "z",
          "name": "Z",
          "description": "",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_relative",
      "name": "Use Relative Paste",
      "description": "When pasting, assume the pasted matrix is relative to another object (set in the user interface)",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "partial",
    "support_note": "headless: the clipboard is always empty (as in blender -b), so pasting always fails with 'Clipboard does not contain a matrix'; assign matrix_world instead",
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": []
  }
}
