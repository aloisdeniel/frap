      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "replace",
      "name": "Replace",
      "description": "The substitute to be inserted into the place of the given search term. If left empty the search term will be removed",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 64,
      "hidden": false,
      "skip_save": false,
