    "support": "partial",
    "support_note": "meshes only: other object types answer OP_NOT_IMPLEMENTED until their Edit Mode handler lands (armatures: M6)",
    "headless": "native",
    "planned": "M2",
    "extension": false,
    "notes": [
      "entering also enters every selected object of the active object's type (multi-object editing)"
    ]
  }
