{
  "idname": "image.pack",
  "bl_idname": "IMAGE_OT_pack",
  "label": "Pack Image",
  "description": "Pack an image as embedded data into the .blend file",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "CONTEXT_IMAGE"
    ],
    "text": "requires the Image Editor's image (bpy.context.edit_image), which headless Blender and frap never have",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "NNNNN"
    }
  },
  "properties": [],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M3",
    "extension": false,
    "notes": [
      "needs the Image Editor's image, which headless Blender and frap do not have: the poll fails as in Blender's background mode; use bpy.data.images['Name'].pack()"
    ]
  }
}
