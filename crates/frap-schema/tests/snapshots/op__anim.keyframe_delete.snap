{
  "idname": "anim.keyframe_delete",
  "bl_idname": "ANIM_OT_keyframe_delete",
  "label": "Delete Keying-Set Keyframe",
  "description": "Delete keyframes on the current frame for all properties in the specified Keying Set",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "YYYYY"
    }
  },
  "properties": [
    {
      "identifier": "type",
      "name": "Keying Set",
      "description": "The Keying Set to use",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "DEFAULT",
      "enum_items": [
        {
          "identifier": "DEFAULT",
          "name": "Default",
          "description": "",
          "value": 0
        },
        {
          "identifier": "Available",
          "name": "Available",
          "description": "Insert a keyframe on each of the already existing F-Curves",
          "value": -1
        },
        {
          "identifier": "Location",
          "name": "Location",
          "description": "Insert a keyframe on each of the location channels",
          "value": -2
        },
        {
          "identifier": "Rotation",
          "name": "Rotation",
          "description": "Insert a keyframe on each of the rotation channels",
          "value": -3
        },
        {
          "identifier": "Scaling",
          "name": "Scale",
          "description": "Insert a keyframe on each of the scale channels",
          "value": -4
        },
        {
          "identifier": "BUILTIN_KSI_LocRot",
          "name": "Location & Rotation",
          "description": "Insert a keyframe on each of the location and rotation channels",
          "value": -5
        },
        {
          "identifier": "LocRotScale",
          "name": "Location, Rotation & Scale",
          "description": "Insert a keyframe on each of the location, rotation, and scale channels",
          "value": -6
        },
        {
          "identifier": "LocRotScaleCProp",
          "name": "Location, Rotation, Scale & Custom Properties",
          "description": "Key location/rotation/scale as well as custom properties",
          "value": -7
        },
        {
          "identifier": "BUILTIN_KSI_LocScale",
          "name": "Location & Scale",
          "description": "Insert a keyframe on each of the location and scale channels",
          "value": -8
        },
        {
          "identifier": "BUILTIN_KSI_RotScale",
          "name": "Rotation & Scale",
          "description": "Insert a keyframe on each of the rotation and scale channels",
          "value": -9
        },
        {
          "identifier": "BUILTIN_KSI_DeltaLocation",
          "name": "Delta Location",
          "description": "Insert keyframes for additional location offset",
          "value": -10
        },
        {
          "identifier": "BUILTIN_KSI_DeltaRotation",
          "name": "Delta Rotation",
          "description": "Insert keyframes for additional rotation offset",
          "value": -11
        },
        {
          "identifier": "BUILTIN_KSI_DeltaScale",
          "name": "Delta Scale",
          "description": "Insert keyframes for additional scale factor",
          "value": -12
        },
        {
          "identifier": "BUILTIN_KSI_VisualLoc",
          "name": "Visual Location",
          "description": "Insert a keyframe on each of the location channels, taking into account effects of constraints and relationships",
          "value": -13
        },
        {
          "identifier": "BUILTIN_KSI_VisualRot",
          "name": "Visual Rotation",
          "description": "Insert a keyframe on each of the rotation channels, taking into account effects of constraints and relationships",
          "value": -14
        },
        {
          "identifier": "BUILTIN_KSI_VisualScaling",
          "name": "Visual Scale",
          "description": "Insert a keyframe on each of the scale channels, taking into account effects of constraints and relationships",
          "value": -15
        },
        {
          "identifier": "BUILTIN_KSI_VisualLocRot",
          "name": "Visual Location & Rotation",
          "description": "Insert a keyframe on each of the location and rotation channels, taking into account effects of constraints and relationships",
          "value": -16
        },
        {
          "identifier": "BUILTIN_KSI_VisualLocRotScale",
          "name": "Visual Location, Rotation & Scale",
          "description": "Insert a keyframe on each of the location, rotation and scale channels, taking into account effects of constraints and relationships",
          "value": -17
        },
        {
          "identifier": "BUILTIN_KSI_VisualLocScale",
          "name": "Visual Location & Scale",
          "description": "Insert a keyframe on each of the location and scale channels, taking into account effects of constraints and relationships",
          "value": -18
        },
        {
          "identifier": "BUILTIN_KSI_VisualRotScale",
          "name": "Visual Rotation & Scale",
          "description": "Insert a keyframe on each of the rotation and scale channels, taking into account effects of constraints and relationships",
          "value": -19
        },
        {
          "identifier": "BUILTIN_KSI_BendyBones",
          "name": "B-Bone Shape",
          "description": "Insert a keyframe for each of the B-Bone shape properties",
          "value": -20
        },
        {
          "identifier": "WholeCharacter",
          "name": "Whole Character",
          "description": "Insert a keyframe for all properties that are likely to get animated in a character rig (useful when blocking out a shot)",
          "value": -21
        },
        {
          "identifier": "WholeCharacterSelected",
          "name": "Whole Character (Selected Bones Only)",
          "description": "Insert a keyframe for all properties that are likely to get animated in a character rig (only selected bones)",
          "value": -22
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": "ANIM_OT_keyframe_delete.type",
      "context_rule": "items depend on the context in Blender (ANIM_OT_keyframe_delete.type); frap narrows them to the live context, enum_items is the superset",
      "hidden": true,
      "skip_save": false,
      "flags": [
        "HIDDEN",
        "ANIMATABLE",
        "DYNAMIC_ENUM",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M6",
    "extension": false,
    "notes": [
      "type lists the built-in keying sets whose poll passes in the context; unset, there is no active keying set (frap scenes have none) and the call fails as in Blender"
    ]
  }
}
