{
  "idname": "mesh.normals_tools",
  "bl_idname": "MESH_OT_normals_tools",
  "label": "Normals Vector Tools",
  "description": "Custom normals tools using Normal Vector of UI",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "mode",
      "name": "Mode",
      "description": "Mode of tools taking input from interface",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "COPY",
      "enum_items": [
        {
          "identifier": "COPY",
          "name": "Copy Normal",
          "description": "Copy normal to the internal clipboard",
          "value": 1
        },
        {
          "identifier": "PASTE",
          "name": "Paste Normal",
          "description": "Paste normal from the internal clipboard",
          "value": 2
        },
        {
          "identifier": "ADD",
          "name": "Add Normal",
          "description": "Add normal vector with selection",
          "value": 4
        },
        {
          "identifier": "MULTIPLY",
          "name": "Multiply Normal",
          "description": "Multiply normal vector with selection",
          "value": 3
        },
        {
          "identifier": "RESET",
          "name": "Reset Normal",
          "description": "Reset the internal clipboard and/or normal of selected element",
          "value": 5
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": true,
      "skip_save": false,
      "flags": [
        "HIDDEN",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "absolute",
      "name": "Absolute Coordinates",
      "description": "Copy Absolute coordinates of Normal vector",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
