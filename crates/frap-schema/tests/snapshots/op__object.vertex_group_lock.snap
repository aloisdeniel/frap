{
  "idname": "object.vertex_group_lock",
  "bl_idname": "OBJECT_OT_vertex_group_lock",
  "label": "Change the Lock On Vertex Groups",
  "description": "Change the lock state of all or some vertex groups of active object",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "ACTIVE_OBJECT",
      "ACTIVE_EDITABLE",
      "ACTIVE_TYPE(MESH)"
    ],
    "text": "requires an active object (bpy.context.view_layer.objects.active), the active object is editable (not linked), the active object is of type MESH",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "NNNNN"
    }
  },
  "properties": [
    {
      "identifier": "action",
      "name": "Action",
      "description": "Lock action to execute on vertex groups",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "TOGGLE",
      "enum_items": [
        {
          "identifier": "TOGGLE",
          "name": "Toggle",
          "description": "Unlock all vertex groups if there is at least one locked group, lock all in other case",
          "value": 0
        },
        {
          "identifier": "LOCK",
          "name": "Lock",
          "description": "Lock all vertex groups",
          "value": 1
        },
        {
          "identifier": "UNLOCK",
          "name": "Unlock",
          "description": "Unlock all vertex groups",
          "value": 2
        },
        {
          "identifier": "INVERT",
          "name": "Invert",
          "description": "Invert the lock state of all vertex groups",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "mask",
      "name": "Mask",
      "description": "Apply the action based on vertex group selection",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "ALL",
      "enum_items": [
        {
          "identifier": "ALL",
          "name": "All",
          "description": "Apply action to all vertex groups",
          "value": 0
        },
        {
          "identifier": "SELECTED",
          "name": "Selected",
          "description": "Apply to selected vertex groups",
          "value": 1
        },
        {
          "identifier": "UNSELECTED",
          "name": "Unselected",
          "description": "Apply to unselected vertex groups",
          "value": 2
        },
        {
          "identifier": "INVERT_UNSELECTED",
          "name": "Invert Unselected",
          "description": "Apply the opposite of Lock/Unlock to unselected vertex groups",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": []
  }
}
