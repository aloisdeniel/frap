    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "type",
      "name": "Type",
      "description": "Merge method to use",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "CENTER",
      "enum_items": [
        {
          "identifier": "CENTER",
          "name": "At Center",
          "description": "",
          "value": 3
        },
        {
          "identifier": "CURSOR",
          "name": "At Cursor",
          "description": "",
          "value": 4
        },
        {
          "identifier": "COLLAPSE",
          "name": "Collapse",
          "description": "",
          "value": 5
        },
        {
          "identifier": "FIRST",
          "name": "At First",
          "description": "",
          "value": 6
        },
        {
          "identifier": "LAST",
          "name": "At Last",
          "description": "",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "uvs",
      "name": "UVs",
      "description": "Move UVs according to merge",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
