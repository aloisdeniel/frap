      "name": "Rotation Method",
      "description": "",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "AXIS_ALIGNED_Y",
      "enum_items": [
        {
          "identifier": "AXIS_ALIGNED",
          "name": "Axis-aligned",
