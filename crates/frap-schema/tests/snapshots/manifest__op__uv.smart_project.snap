{
  "idname": "uv.smart_project",
  "bl_idname": "UV_OT_smart_project",
  "label": "Smart UV Project",
  "description": "Projection unwraps the selected faces of mesh objects",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": null,
    "text": "Blender 5.2's poll passes in: C (Edit Mode on a mesh)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "angle_limit",
      "name": "Angle Limit",
      "description": "Lower for more projection groups, higher for less distortion",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 1.1519173,
      "hard_min": 0,
      "hard_max": 1.5707964,
      "soft_min": 0,
      "soft_max": 1.553343,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "margin_method",
      "name": "Margin Method",
      "description": "",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "SCALED",
      "enum_items": [
        {
          "identifier": "SCALED",
          "name": "Scaled",
          "description": "Use scale of existing UVs to multiply margin",
          "value": 0
        },
        {
          "identifier": "ADD",
          "name": "Add",
          "description": "Just add the margin, ignoring any UV scale",
          "value": 1
        },
        {
          "identifier": "FRACTION",
          "name": "Fraction",
          "description": "Specify a precise fraction of final UV output",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
