      "default": "GEOMETRY_ORIGIN",
      "enum_items": [
        {
          "identifier": "GEOMETRY_ORIGIN",
          "name": "Geometry to Origin",
          "description": "Move object geometry to object origin",
          "value": 0
        },
        {
          "identifier": "ORIGIN_GEOMETRY",
          "name": "Origin to Geometry",
          "description": "Calculate the center of geometry based on the current pivot point (median, otherwise bounding box)",
          "value": 1
        },
        {
          "identifier": "ORIGIN_CURSOR",
          "name": "Origin to 3D Cursor",
          "description": "Move object origin to position of the 3D cursor",
          "value": 2
        },
        {
          "identifier": "ORIGIN_CENTER_OF_MASS",
          "name": "Origin to Center of Mass (Surface)",
          "description": "Calculate the center of mass from the surface area",
          "value": 3
        },
        {
          "identifier": "ORIGIN_CENTER_OF_VOLUME",
          "name": "Origin to Center of Mass (Volume)",
          "description": "Calculate the center of mass from the volume (must be manifold geometry with consistent normals)",
          "value": 4
        }
      ],
