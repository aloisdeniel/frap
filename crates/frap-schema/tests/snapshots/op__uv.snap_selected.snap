    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": "headless-extended: runs as in an Image Editor in UV mode without an image (Blender's poll needs one; blender -b has none): image size 256 x 256, pivot BOUNDING_BOX_CENTER, the 2D cursor kept per scene and moved only by uv.snap_cursor (starts at the origin)",
    "headless": "extended",
    "planned": "M8",
