      "description": "Mirror vertices based on mesh axis",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "POS_X",
      "enum_items": [
        {
          "identifier": "POS_X",
          "name": "-X to +X",
          "description": "",
          "value": 0
        },
        {
