  ],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M3",
    "extension": false,
    "notes": [
      "needs the Image Editor's image (also with id=…), which headless Blender and frap do not have: the poll fails as in Blender's background mode; use bpy.data.images['Name'].unpack(method='USE_LOCAL')"
    ]
  }
