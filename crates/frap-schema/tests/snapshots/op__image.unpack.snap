{
  "idname": "image.unpack",
  "bl_idname": "IMAGE_OT_unpack",
  "label": "Unpack Image",
  "description": "Save an image packed in the .blend file to disk",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "NNNNN"
    }
  },
  "properties": [
    {
      "identifier": "method",
      "name": "Method",
      "description": "How to unpack",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "USE_LOCAL",
      "enum_items": [
        {
          "identifier": "REMOVE",
          "name": "Remove Pack",
          "description": "",
          "value": 8
        },
        {
          "identifier": "USE_LOCAL",
          "name": "Use Local File",
          "description": "",
          "value": 5
        },
        {
          "identifier": "WRITE_LOCAL",
          "name": "Write Local File (overwrite existing)",
          "description": "",
          "value": 4
        },
        {
          "identifier": "USE_ORIGINAL",
          "name": "Use Original File",
          "description": "",
          "value": 6
        },
        {
          "identifier": "WRITE_ORIGINAL",
          "name": "Write Original File (overwrite existing)",
          "description": "",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "id",
      "name": "Image Name",
      "description": "Image data-block name to unpack",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 256,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
