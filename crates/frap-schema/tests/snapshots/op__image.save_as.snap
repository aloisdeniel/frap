          "identifier": "ASSET_CATALOG",
          "name": "Asset Catalog",
          "description": "Sort the asset list so that assets in the same catalog are kept together. Within a single catalog, assets are ordered by name. The catalogs are in order of the flattened catalog hierarchy.",
          "value": 5
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": "IMAGE_OT_save_as.sort_method",
      "context_rule": "items come from a Blender callback that depends on the context (IMAGE_OT_save_as.sort_method); enum_items is frap's verified superset (spec/overlay/dynamic_enums.toml)",
