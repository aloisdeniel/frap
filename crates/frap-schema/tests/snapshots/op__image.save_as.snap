{
  "idname": "image.save_as",
  "bl_idname": "IMAGE_OT_save_as",
  "label": "Save As Image",
  "description": "Save the image with another name and/or settings",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "CONTEXT_IMAGE"
    ],
    "text": "requires the Image Editor's image (bpy.context.edit_image), which headless Blender and frap never have",
    "matrix": {
      "plain": "NNNNN",
      "view3d": "NNNNN"
    }
  },
  "properties": [
    {
      "identifier": "save_as_render",
      "name": "Save As Render",
      "description": "Save image with render color management.\nFor display image formats like PNG, apply view and display transform.\nFor intermediate image formats like OpenEXR, use the default render output color space",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ANIMATABLE",
