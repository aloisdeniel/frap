      "identifier": "miter_outer",
      "name": "Outer Miter",
      "description": "Pattern to use for outside of miters",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "SHARP",
      "enum_items": [
        {
          "identifier": "SHARP",
          "name": "Sharp",
          "description": "Outside of miter is sharp",
          "value": 0
        },
        {
          "identifier": "PATCH",
          "name": "Patch",
          "description": "Outside of miter is squared-off patch",
          "value": 1
        },
        {
          "identifier": "ARC",
          "name": "Arc",
          "description": "Outside of miter is arc",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
