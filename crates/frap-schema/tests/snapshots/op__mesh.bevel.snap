{
  "idname": "mesh.bevel",
  "bl_idname": "MESH_OT_bevel",
  "label": "Bevel",
  "description": "Cut into selected items at an angle to create bevel or chamfer",
  "bl_options": [
    "BLOCKING",
    "GRAB_CURSOR",
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "offset_type",
      "name": "Width Type",
      "description": "The method for determining the size of the bevel",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "OFFSET",
      "enum_items": [
        {
          "identifier": "OFFSET",
          "name": "Offset",
          "description": "Amount is offset of new edges from original",
          "value": 0
        },
        {
          "identifier": "WIDTH",
          "name": "Width",
          "description": "Amount is width of new face",
          "value": 1
        },
        {
          "identifier": "DEPTH",
          "name": "Depth",
          "description": "Amount is perpendicular distance from original edge to bevel face",
          "value": 2
        },
        {
          "identifier": "PERCENT",
          "name": "Percent",
          "description": "Amount is percent of adjacent edge length",
          "value": 3
        },
        {
          "identifier": "ABSOLUTE",
          "name": "Absolute",
          "description": "Amount is absolute distance along adjacent edge",
          "value": 4
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "offset",
      "name": "Width",
      "description": "Bevel amount",
      "type": "FLOAT",
      "subtype": "DISTANCE",
      "unit": "LENGTH",
      "array": null,
      "default": 0,
      "hard_min": 0,
      "hard_max": 1000000,
      "soft_min": 0,
      "soft_max": 100,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "bevel with the default offset=0 changes nothing; always pass offset (and segments)",
      "frap_extension": false
    },
    {
      "identifier": "profile_type",
      "name": "Profile Type",
      "description": "The type of shape used to rebuild a beveled section",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "SUPERELLIPSE",
      "enum_items": [
        {
          "identifier": "SUPERELLIPSE",
          "name": "Superellipse",
          "description": "The profile can be a concave or convex curve",
          "value": 0
        },
        {
          "identifier": "CUSTOM",
          "name": "Custom",
          "description": "The profile can be any arbitrary path between its endpoints",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "offset_pct",
      "name": "Width Percent",
      "description": "Bevel amount for percentage method",
      "type": "FLOAT",
      "subtype": "PERCENTAGE",
      "unit": "NONE",
      "array": null,
      "default": 0,
      "hard_min": 0,
      "hard_max": 100,
      "soft_min": 0,
      "soft_max": 100,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "segments",
      "name": "Segments",
      "description": "Segments for curved edge",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 1,
      "hard_min": 1,
      "hard_max": 1000,
      "soft_min": 1,
      "soft_max": 100,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "profile",
      "name": "Profile",
      "description": "Controls profile shape (0.5 = round)",
      "type": "FLOAT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 0.5,
      "hard_min": 0,
      "hard_max": 1,
      "soft_min": 0,
      "soft_max": 1,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "affect",
      "name": "Affect",
      "description": "Affect edges or vertices",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "EDGES",
      "enum_items": [
        {
          "identifier": "VERTICES",
          "name": "Vertices",
          "description": "Affect only vertices",
          "value": 0
        },
        {
          "identifier": "EDGES",
          "name": "Edges",
          "description": "Affect only edges",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "clamp_overlap",
      "name": "Clamp Overlap",
      "description": "Do not allow beveled edges/vertices to overlap each other",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "loop_slide",
      "name": "Loop Slide",
      "description": "Prefer sliding along edges to even widths",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "mark_seam",
      "name": "Mark Seams",
      "description": "Preserve seams along beveled edges",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "mark_sharp",
      "name": "Mark Sharp",
      "description": "Preserve sharp edges along beveled edges",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "material",
      "name": "Material Index",
      "description": "Material for bevel faces (-1 means use adjacent faces)",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": -1,
      "hard_min": -1,
      "hard_max": 2147483647,
      "soft_min": -1,
      "soft_max": 100,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "harden_normals",
      "name": "Harden Normals",
      "description": "Match normals of new faces to adjacent faces",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "face_strength_mode",
      "name": "Face Strength Mode",
      "description": "Whether to set face strength, and which faces to set face strength on",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "NONE",
      "enum_items": [
        {
          "identifier": "NONE",
          "name": "None",
          "description": "Do not set face strength",
          "value": 0
        },
        {
          "identifier": "NEW",
          "name": "New",
          "description": "Set face strength on new faces only",
          "value": 1
        },
        {
          "identifier": "AFFECTED",
          "name": "Affected",
          "description": "Set face strength on new and modified faces only",
          "value": 2
        },
        {
          "identifier": "ALL",
          "name": "All",
          "description": "Set face strength on all faces",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
