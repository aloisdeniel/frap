{
  "idname": "uv.pack_islands",
  "bl_idname": "UV_OT_pack_islands",
  "label": "Pack Islands",
  "description": "Transform all islands so that they fill up the UV/UDIM space as much as possible",
  "bl_options": [
    "REGISTER"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "udim_source",
      "name": "Pack to",
      "description": "",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "CLOSEST_UDIM",
      "enum_items": [
        {
          "identifier": "CLOSEST_UDIM",
          "name": "Closest UDIM",
          "description": "Pack islands to closest UDIM",
          "value": 0
        },
        {
          "identifier": "ACTIVE_UDIM",
          "name": "Active UDIM",
          "description": "Pack islands to active UDIM image tile or UDIM grid tile where 2D cursor is located",
          "value": 1
        },
        {
          "identifier": "ORIGINAL_AABB",
          "name": "Original bounding box",
          "description": "Pack to starting bounding box of islands",
          "value": 2
        },
        {
          "identifier": "CUSTOM_REGION",
          "name": "Custom Region",
          "description": "Pack islands to custom region",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
