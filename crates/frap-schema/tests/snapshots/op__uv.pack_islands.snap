        {
          "identifier": "AXIS_ALIGNED_X",
          "name": "Axis-aligned (Horizontal)",
          "description": "Rotate islands to be aligned horizontally",
          "value": 2
        },
        {
          "identifier": "AXIS_ALIGNED_Y",
          "name": "Axis-aligned (Vertical)",
          "description": "Rotate islands to be aligned vertically",
          "value": 3
