        },
        {
          "identifier": "CARDINAL",
          "name": "Cardinal",
          "description": "Only 90 degree rotations are allowed",
          "value": 4
        },
        {
          "identifier": "AXIS_ALIGNED",
          "name": "Axis-aligned",
          "description": "Rotated to a minimal rectangle, either vertical or horizontal",
          "value": 1
