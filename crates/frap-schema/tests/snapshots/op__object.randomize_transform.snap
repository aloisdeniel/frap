{
  "idname": "object.randomize_transform",
  "bl_idname": "OBJECT_OT_randomize_transform",
  "label": "Randomize Transform",
  "description": "Randomize objects location, rotation, and scale",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "SCENE_EDITABLE",
      "MODE_OBJECT"
    ],
