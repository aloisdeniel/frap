    "matrix": {
      "plain": "YYNNN",
      "view3d": "YYNNN"
    }
  },
  "properties": [
    {
      "identifier": "random_seed",
      "name": "Random Seed",
      "description": "Seed value for the random generator",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 0,
      "hard_min": 0,
      "hard_max": 10000,
      "soft_min": 0,
      "soft_max": 10000,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_delta",
      "name": "Transform Delta",
      "description": "Randomize delta transform values instead of regular transform",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_loc",
      "name": "Randomize Location",
      "description": "Randomize the location values",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "loc",
      "name": "Location",
      "description": "Maximum distance the objects can spread over each axis",
      "type": "FLOAT",
      "subtype": "TRANSLATION",
      "unit": "LENGTH",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -100,
      "hard_max": 100,
      "soft_min": -100,
      "soft_max": 100,
      "precision": 2,
