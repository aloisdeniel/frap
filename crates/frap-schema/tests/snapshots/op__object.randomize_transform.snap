      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_rot",
      "name": "Randomize Rotation",
      "description": "Randomize the rotation values",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
