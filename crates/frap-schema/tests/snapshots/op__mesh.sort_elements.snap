{
  "idname": "mesh.sort_elements",
  "bl_idname": "MESH_OT_sort_elements",
  "label": "Sort Mesh Elements",
  "description": "The order of selected vertices/edges/faces is modified, based on a given method",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "type",
      "name": "Type",
      "description": "Type of reordering operation to apply",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "VIEW_ZAXIS",
      "enum_items": [
        {
          "identifier": "VIEW_ZAXIS",
          "name": "View Z Axis",
          "description": "Sort selected elements from farthest to nearest one in current view",
          "value": 1
        },
        {
          "identifier": "VIEW_XAXIS",
          "name": "View X Axis",
          "description": "Sort selected elements from left to right one in current view",
          "value": 2
        },
        {
          "identifier": "CURSOR_DISTANCE",
          "name": "Cursor Distance",
          "description": "Sort selected elements from nearest to farthest from 3D cursor",
          "value": 3
        },
        {
          "identifier": "MATERIAL",
          "name": "Material",
          "description": "Sort selected faces from smallest to greatest material index",
          "value": 4
        },
        {
          "identifier": "SELECTED",
          "name": "Selected",
          "description": "Move all selected elements in first places, preserving their relative order.\nWarning: This will affect unselected elements' indices as well",
          "value": 5
        },
        {
          "identifier": "RANDOMIZE",
          "name": "Randomize",
          "description": "Randomize order of selected elements",
          "value": 6
        },
        {
          "identifier": "REVERSE",
          "name": "Reverse",
          "description": "Reverse current order of selected elements",
          "value": 7
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
