{
  "idname": "uv.export_layout",
  "bl_idname": "UV_OT_export_layout",
  "label": "Export UV Layout",
  "description": "Export UV layout to file",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "ACTIVE_TYPE(MESH)"
    ],
    "text": "requires the active object is of type MESH",
    "matrix": {
      "plain": "YNYNN",
      "view3d": "YNYNN"
    }
  },
  "properties": [
    {
      "identifier": "filepath",
      "name": "filepath",
      "description": "",
      "type": "STRING",
      "subtype": "FILE_PATH",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 0,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_all",
      "name": "All UVs",
      "description": "Export all UVs in this mesh (not just visible ones)",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_tiles",
      "name": "Export Tiles",
      "description": "Choose whether to export only the [0, 1] range, or all UV tiles",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "NONE",
      "enum_items": [
        {
          "identifier": "NONE",
          "name": "None",
          "description": "Export only UVs in the [0, 1] range",
          "value": 0
        },
        {
          "identifier": "UDIM",
          "name": "UDIM",
          "description": "Export tiles in the UDIM numbering scheme: 1001 + u_tile + 10*v_tile",
          "value": 1
        },
        {
          "identifier": "UV",
          "name": "UVTILE",
          "description": "Export tiles in the UVTILE numbering scheme: u(u_tile + 1)_v(v_tile + 1)",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "modified",
      "name": "Modified",
      "description": "Exports UVs from the modified mesh",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "mode",
      "name": "Format",
      "description": "File format to export the UV layout to",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "PNG",
      "enum_items": [
        {
          "identifier": "SVG",
          "name": "Scalable Vector Graphic (.svg)",
          "description": "Export the UV layout to a vector SVG file",
          "value": 0
        },
        {
          "identifier": "EPS",
          "name": "Encapsulated PostScript (.eps)",
          "description": "Export the UV layout to a vector EPS file",
          "value": 1
        },
        {
          "identifier": "PNG",
          "name": "PNG Image (.png)",
          "description": "Export the UV layout to a bitmap image",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "size",
      "name": "Size",
      "description": "Dimensions of the exported file",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": [
        2
      ],
      "default": [
        1024,
        1024
      ],
      "hard_min": 8,
      "hard_max": 32768,
      "soft_min": 8,
      "soft_max": 32768,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
