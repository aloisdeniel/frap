    },
    {
      "identifier": "opacity",
      "name": "Fill Opacity",
      "description": "Set amount of opacity for exported UV layout",
      "type": "FLOAT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 0.25,
      "hard_min": 0,
      "hard_max": 1,
      "soft_min": 0,
      "soft_max": 1,
      "precision": 2,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "check_existing",
      "name": "check_existing",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": true,
      "skip_save": false,
      "flags": [
        "HIDDEN",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": [
      "PNG drawn on the CPU (Blender draws it on the GPU and needs gpu.init() in background mode); SVG and EPS name frap in their generator line",
      "several meshes are visited active first, then in view-layer order (the add-on walks a Python set of objects)"
    ]
  }
