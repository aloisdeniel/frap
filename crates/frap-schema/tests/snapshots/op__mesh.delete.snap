{
  "idname": "mesh.delete",
  "bl_idname": "MESH_OT_delete",
  "label": "Delete",
  "description": "Delete selected vertices, edges or faces",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "type",
      "name": "Type",
      "description": "Method used for deleting mesh data",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "VERT",
      "enum_items": [
        {
          "identifier": "VERT",
          "name": "Vertices",
          "description": "",
          "value": 0
        },
        {
          "identifier": "EDGE",
          "name": "Edges",
          "description": "",
          "value": 1
        },
        {
          "identifier": "FACE",
          "name": "Faces",
          "description": "",
          "value": 2
        },
        {
          "identifier": "EDGE_FACE",
          "name": "Only Edges & Faces",
          "description": "",
          "value": 3
        },
        {
          "identifier": "ONLY_FACE",
          "name": "Only Faces",
          "description": "",
          "value": 4
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M2",
    "extension": false,
    "notes": [
      "type is HIDDEN in Blender's UI but settable: VERT (default) | EDGE | FACE | EDGE_FACE | ONLY_FACE",
      "everything is deselected afterwards; result.removed / removed_edges / removed_faces count the deleted elements",
      "CANCELLED (with a WARNING) when no edit mesh has a matching selection"
    ]
  }
}
