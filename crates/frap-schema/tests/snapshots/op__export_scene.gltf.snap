---
source: crates/frap-schema/tests/describe_ops.rs
---
{
  "idname": "export_scene.gltf",
  "bl_idname": "EXPORT_SCENE_OT_gltf",
  "label": "Export glTF 2.0",
  "description": "Export scene as glTF 2.0 file",
  "bl_options": [
    "PRESET"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "YYYYY",
      "view3d": "YYYYY"
    }
  },
  "properties": [
    {
      "identifier": "filepath",
      "name": "File Path",
      "description": "Filepath used for exporting the file",
      "type": "STRING",
      "subtype": "FILE_PATH",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 1025,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "check_existing",
      "name": "Check Existing",
      "description": "Check and warn on overwriting existing files",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": true,
      "skip_save": false,
      "flags": [
        "HIDDEN",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_import_convert_lighting_mode",
      "name": "Lighting Mode",
      "description": "Optional backwards compatibility for non-standard render engines. Applies to lights",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "SPEC",
      "enum_items": [
        {
          "identifier": "SPEC",
          "name": "Standard",
          "description": "Physically-based glTF lighting units (cd, lx, nt)",
          "value": 0
        },
        {
          "identifier": "COMPAT",
          "name": "Unitless",
          "description": "Non-physical, unitless lighting. Useful when exposure controls are not available",
          "value": 1
        },
        {
          "identifier": "RAW",
          "name": "Raw (Deprecated)",
          "description": "Blender lighting strengths with no conversion",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "gltf_export_id",
      "name": "Identifier",
      "description": "Identifier of caller (in case of add-on calling this exporter). Can be useful in case of Extension added by other add-ons",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 0,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_use_gltfpack",
      "name": "Use Gltfpack",
      "description": "Use gltfpack to simplify the mesh and/or compress its textures",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_tc",
      "name": "KTX2 Compression",
      "description": "Convert all textures to KTX2 with BasisU supercompression",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_tq",
      "name": "Texture Encoding Quality",
      "description": "Texture encoding quality",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 8,
      "hard_min": 1,
      "hard_max": 10,
      "soft_min": 1,
      "soft_max": 10,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_si",
      "name": "Mesh Simplification Ratio",
      "description": "Simplify meshes targeting triangle count ratio",
      "type": "FLOAT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 1,
      "hard_min": 0,
      "hard_max": 1,
      "soft_min": 0,
      "soft_max": 1,
      "precision": 2,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_sa",
      "name": "Aggressive Mesh Simplification",
      "description": "Aggressively simplify to the target ratio disregarding quality",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_slb",
      "name": "Lock Mesh Border Vertices",
      "description": "Lock border vertices during simplification to avoid gaps on connected meshes",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_vp",
      "name": "Position Quantization",
      "description": "Use N-bit quantization for positions",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 14,
      "hard_min": 1,
      "hard_max": 16,
      "soft_min": 1,
      "soft_max": 16,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_vt",
      "name": "Texture Coordinate Quantization",
      "description": "Use N-bit quantization for texture coordinates",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 12,
      "hard_min": 1,
      "hard_max": 16,
      "soft_min": 1,
      "soft_max": 16,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_vn",
      "name": "Normal/Tangent Quantization",
      "description": "Use N-bit quantization for normals and tangents",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 8,
      "hard_min": 1,
      "hard_max": 16,
      "soft_min": 1,
      "soft_max": 16,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_vc",
      "name": "Vertex Color Quantization",
      "description": "Use N-bit quantization for colors",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 8,
      "hard_min": 1,
      "hard_max": 16,
      "soft_min": 1,
      "soft_max": 16,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_vpi",
      "name": "Vertex Position Attributes",
      "description": "Type to use for vertex position attributes",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "Integer",
      "enum_items": [
        {
          "identifier": "Integer",
          "name": "Integer",
          "description": "Use integer attributes for positions",
          "value": 0
        },
        {
          "identifier": "Normalized",
          "name": "Normalized",
          "description": "Use normalized attributes for positions",
          "value": 1
        },
        {
          "identifier": "Floating-point",
          "name": "Floating-point",
          "description": "Use floating-point attributes for positions",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_noq",
      "name": "Disable Quantization",
      "description": "Disable quantization; produces much larger glTF files with no extensions",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gltfpack_kn",
      "name": "Keep Named Nodes",
      "description": "Restrict some optimization to keep named nodes and meshes attached to named nodes so that named nodes can be transformed externally",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_format",
      "name": "Format",
      "description": "Output format. Binary is most efficient, but JSON may be easier to edit later",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "GLB",
      "enum_items": [
        {
          "identifier": "GLB",
          "name": "glTF Binary (.glb)",
          "description": "Exports a single file, with all data packed in binary form. Most efficient and portable, but more difficult to edit later",
          "value": 0
        },
        {
          "identifier": "GLTF_SEPARATE",
          "name": "glTF Separate (.gltf + .bin + textures)",
          "description": "Exports multiple files, with separate JSON, binary and texture data. Easiest to edit later",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": "EXPORT_SCENE_OT_gltf.export_format",
      "context_rule": "items depend on the context in Blender (EXPORT_SCENE_OT_gltf.export_format); frap narrows them to the live context, enum_items is the superset",
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE",
        "DYNAMIC_ENUM"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "ui_tab",
      "name": "ui_tab",
      "description": "Export setting categories",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "GENERAL",
      "enum_items": [
        {
          "identifier": "GENERAL",
          "name": "General",
          "description": "General settings",
          "value": 0
        },
        {
          "identifier": "MESHES",
          "name": "Meshes",
          "description": "Mesh settings",
          "value": 1
        },
        {
          "identifier": "OBJECTS",
          "name": "Objects",
          "description": "Object settings",
          "value": 2
        },
        {
          "identifier": "ANIMATION",
          "name": "Animation",
          "description": "Animation settings",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_copyright",
      "name": "Copyright",
      "description": "Legal rights and conditions for the model",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 0,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_image_format",
      "name": "Images",
      "description": "Output format for images. PNG is lossless and generally preferred, but JPEG might be preferable for web applications due to the smaller file size. Alternatively they can be omitted if they are not needed",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "AUTO",
      "enum_items": [
        {
          "identifier": "AUTO",
          "name": "Automatic",
          "description": "Save PNGs as PNGs, JPEGs as JPEGs, WebPs as WebPs. For other formats, use PNG",
          "value": 0
        },
        {
          "identifier": "JPEG",
          "name": "JPEG Format (.jpg)",
          "description": "Save images as JPEGs. (Images that need alpha are saved as PNGs though.) Be aware of a possible loss in quality",
          "value": 1
        },
        {
          "identifier": "WEBP",
          "name": "WebP Format",
          "description": "Save images as WebPs as main image (no fallback)",
          "value": 2
        },
        {
          "identifier": "NONE",
          "name": "None",
          "description": "Don't export images",
          "value": 3
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_image_add_webp",
      "name": "Create WebP",
      "description": "Creates WebP textures for every texture. For already WebP textures, nothing happens",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_image_webp_fallback",
      "name": "WebP Fallback",
      "description": "For all WebP textures, create a PNG fallback texture",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_texture_dir",
      "name": "Textures",
      "description": "Folder to place texture files in. Relative to the .gltf file",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 0,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "NEVER_NULL"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_jpeg_quality",
      "name": "JPEG Quality",
      "description": "Quality of JPEG export",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 75,
      "hard_min": 0,
      "hard_max": 100,
      "soft_min": 0,
      "soft_max": 100,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_image_quality",
      "name": "Image Quality",
      "description": "Quality of image export",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 75,
      "hard_min": 0,
      "hard_max": 100,
      "soft_min": 0,
      "soft_max": 100,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_keep_originals",
      "name": "Keep Original",
      "description": "Keep original textures files if possible. WARNING: if you use more than one texture, where pbr standard requires only one, only one texture will be used. This can lead to unexpected results",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_texcoords",
      "name": "UVs",
      "description": "Export UVs (texture coordinates) with meshes",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_normals",
      "name": "Normals",
      "description": "Export vertex normals with meshes",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_gn_mesh",
      "name": "Geometry Nodes Instances (Experimental)",
      "description": "Export Geometry nodes instance meshes",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_meshopt_compression_enable",
      "name": "Meshopt Compression",
      "description": "Compress mesh using Meshopt",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_meshopt_extension",
      "name": "Meshopt Extension",
      "description": "Extension to use for meshopt compression",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "EXT_meshopt_compression",
      "enum_items": [
        {
          "identifier": "EXT_meshopt_compression",
          "name": "EXT_meshopt_compression",
          "description": "Use EXT_meshopt_compression extension for mesh compression",
          "value": 0
        },
        {
          "identifier": "KHR_meshopt_compression",
          "name": "KHR_meshopt_compression",
          "description": "Use KHR_meshopt_compression extension for mesh compression",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_draco_mesh_compression_enable",
      "name": "Draco Mesh Compression",
      "description": "Compress mesh using Draco",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_draco_mesh_compression_level",
      "name": "Compression Level",
      "description": "Compression level (0 = most speed, 6 = most compression, higher values currently not supported)",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 6,
      "hard_min": 0,
      "hard_max": 10,
      "soft_min": 0,
      "soft_max": 10,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "export_draco_position_quantization",
      "name": "Position Quantization Bits",
      "description": "Quantization bits for position values (0 = no quantization)",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 14,
