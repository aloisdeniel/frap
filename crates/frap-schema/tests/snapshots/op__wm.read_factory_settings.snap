{
  "idname": "wm.read_factory_settings",
  "bl_idname": "WM_OT_read_factory_settings",
  "label": "Load Factory Settings",
  "description": "Load factory default startup file and preferences. To make changes permanent, use \"Save Startup File\" and \"Save Preferences\"",
  "bl_options": [],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "YYYYY",
      "view3d": "YYYYY"
    }
  },
  "properties": [
    {
      "identifier": "use_factory_startup_app_template_only",
      "name": "Factory Startup App-Template Only",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "app_template",
      "name": "",
      "description": "",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "Template",
      "length_max": 64,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "NEVER_NULL",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_empty",
      "name": "Empty",
      "description": "After loading, remove everything except scenes, windows, and workspaces. This makes it possible to load the startup file with its scene configuration and window layout intact, but no objects, materials, animations, ...",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M1",
    "extension": false,
    "notes": [
      "resets the scene to the factory startup and the glTF add-on preferences to their defaults (frap has no other user preferences)"
    ]
  }
