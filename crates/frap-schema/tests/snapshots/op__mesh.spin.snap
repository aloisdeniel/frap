{
  "idname": "mesh.spin",
  "bl_idname": "MESH_OT_spin",
  "label": "Spin",
  "description": "Extrude selected vertices in a circle around the cursor in indicated viewport",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "steps",
      "name": "Steps",
      "description": "Steps",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 12,
      "hard_min": 0,
      "hard_max": 1000000,
      "soft_min": 0,
      "soft_max": 1000,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "dupli",
      "name": "Use Duplicates",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "angle",
      "name": "Angle",
      "description": "Rotation for each step",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 1.5707964,
      "hard_min": -1000000000000,
      "hard_max": 1000000000000,
      "soft_min": -6.2831855,
      "soft_max": 6.2831855,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": false
    },
    {
      "identifier": "use_auto_merge",
      "name": "Auto Merge",
      "description": "Merge first/last when the angle is a full revolution",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_normal_flip",
      "name": "Flip Normals",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "center",
      "name": "Center",
      "description": "Center in global view space",
      "type": "FLOAT",
      "subtype": "XYZ_LENGTH",
      "unit": "LENGTH",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -1000000000000,
      "hard_max": 1000000000000,
      "soft_min": -10000,
      "soft_max": 10000,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "axis",
      "name": "Axis",
      "description": "Axis in global view space",
      "type": "FLOAT",
      "subtype": "XYZ",
      "unit": "NONE",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        0
      ],
      "hard_min": -1,
      "hard_max": 1,
      "soft_min": -1,
      "soft_max": 1,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T2",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M2",
    "extension": false,
    "notes": [
      "axis is required (no view to take it from), as in blender -b",
      "the side faces of each step are created in iteration order, one of the orders Blender produces (its order changes from run to run)"
    ]
  }
}
