      "frap_extension": false
    },
    {
      "identifier": "new_collection_name",
      "name": "Name",
      "description": "Name of a to-be-added bone collection. Only pass this if you want to create a new bone collection and assign the selected bones to it. To assign to an existing collection, do not include this parameter and use collection_index",
