{
  "idname": "mesh.select_axis",
  "bl_idname": "MESH_OT_select_axis",
  "label": "Select Axis",
  "description": "Select all data in the mesh on a single axis",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "orientation",
      "name": "Axis Mode",
      "description": "Axis orientation",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "LOCAL",
      "enum_items": [
        {
          "identifier": "GLOBAL",
          "name": "Global",
          "description": "Align the transformation axes to world space",
          "value": 0
        },
        {
          "identifier": "LOCAL",
          "name": "Local",
          "description": "Align the transformation axes to the selected objects' local space",
          "value": 1
        },
        {
          "identifier": "NORMAL",
          "name": "Normal",
          "description": "Align the transformation axes to average normal of selected elements (bone Y axis for pose mode)",
          "value": 2
        },
        {
          "identifier": "GIMBAL",
          "name": "Gimbal",
          "description": "Align each axis to the Euler rotation axis as used for input",
          "value": 4
        },
        {
          "identifier": "VIEW",
          "name": "View",
          "description": "Align the transformation axes to the window",
          "value": 3
        },
        {
          "identifier": "CURSOR",
          "name": "Cursor",
          "description": "Align the transformation axes to the 3D cursor",
          "value": 5
        },
        {
          "identifier": "PARENT",
          "name": "Parent",
          "description": "Align the transformation axes to the object's parent space",
          "value": 6
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
