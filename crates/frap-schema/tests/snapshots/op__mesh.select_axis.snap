      "name": "Axis Sign",
      "description": "Side to select",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "POS",
      "enum_items": [
        {
          "identifier": "POS",
          "name": "Positive Axis",
          "description": "",
          "value": 0
        },
        {
          "identifier": "NEG",
          "name": "Negative Axis",
          "description": "",
          "value": 1
        },
        {
          "identifier": "ALIGN",
          "name": "Aligned Axis",
          "description": "",
          "value": 2
