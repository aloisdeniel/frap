    "status": "implemented",
    "tier": "T1",
    "support": "partial",
    "support_note": ".frap files only (a .blend path is IO_UNSUPPORTED_FORMAT)",
    "headless": "native",
    "planned": "M1",
    "extension": false,
    "notes": [
      "saves to bpy.data.filepath when filepath is empty",
      "compress, relative_remap, exit and the file-browser props are accepted and ignored with an INFO report"
