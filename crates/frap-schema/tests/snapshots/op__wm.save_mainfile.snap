    {
      "identifier": "sort_method",
      "name": "File sorting mode",
      "description": "",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "",
      "enum_items": [
        {
          "identifier": "DEFAULT",
          "name": "Default",
          "description": "Automatically determine sort method for files",
          "value": 0
        },
        {
          "identifier": "FILE_SORT_ALPHA",
          "name": "Name",
          "description": "Sort the file list alphabetically",
          "value": 1
        },
        {
          "identifier": "FILE_SORT_EXTENSION",
          "name": "Extension",
          "description": "Sort the file list by extension/type",
          "value": 2
        },
        {
          "identifier": "FILE_SORT_TIME",
          "name": "Modified Date",
          "description": "Sort files by modification time",
          "value": 3
        },
        {
          "identifier": "FILE_SORT_SIZE",
          "name": "Size",
          "description": "Sort files by size",
          "value": 4
        },
        {
          "identifier": "ASSET_CATALOG",
          "name": "Asset Catalog",
          "description": "Sort the asset list so that assets in the same catalog are kept together. Within a single catalog, assets are ordered by name. The catalogs are in order of the flattened catalog hierarchy.",
          "value": 5
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": "WM_OT_save_mainfile.sort_method",
      "context_rule": "items come from a Blender callback that depends on the context (WM_OT_save_mainfile.sort_method); enum_items is frap's verified superset (spec/overlay/dynamic_enums.toml)",
      "hidden": true,
      "skip_save": true,
      "flags": [
