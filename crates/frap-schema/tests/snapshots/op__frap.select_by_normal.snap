{
  "idname": "frap.select_by_normal",
  "bl_idname": "FRAP_OT_select_by_normal",
  "label": "Select by Normal",
  "description": "Select the faces whose normal points within an angle of a direction (frap extension)",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": null
  },
  "properties": [
    {
      "identifier": "direction",
      "name": "Direction",
      "description": "Direction the faces should face",
      "type": "FLOAT",
      "subtype": "XYZ",
      "unit": "NONE",
      "array": [
        3
      ],
      "default": [
        0,
        0,
        1
      ],
      "hard_min": -340282350000000000000000000000000000000.0,
      "hard_max": 340282350000000000000000000000000000000.0,
      "soft_min": -1,
      "soft_max": 1,
      "precision": 3,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    },
    {
      "identifier": "threshold",
      "name": "Threshold",
      "description": "Largest angle between a face normal and the direction",
      "type": "FLOAT",
      "subtype": "ANGLE",
      "unit": "ROTATION (radians)",
      "array": null,
      "default": 0.5235988,
      "hard_min": 0,
      "hard_max": 3.1415927,
      "soft_min": 0,
      "soft_max": 3.1415927,
      "precision": 3,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": "radians; a whole number above 2π gets the ANGLE_LIKELY_DEGREES hint (use radians(90))",
      "frap_extension": true
    },
    {
      "identifier": "orientation",
      "name": "Orientation",
      "description": "Space of the direction",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "GLOBAL",
      "enum_items": [
        {
          "identifier": "GLOBAL",
          "name": "Global",
          "description": "World space",
          "value": 0
        },
        {
          "identifier": "LOCAL",
          "name": "Local",
          "description": "Each object's local space",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    },
    {
      "identifier": "extend",
      "name": "Extend",
      "description": "Keep the current selection",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M2",
    "extension": true,
    "notes": [
      "frap extension: selects the visible faces whose normal is within threshold of direction (GLOBAL: world space; LOCAL: each object's local space)",
      "every mesh in Edit Mode takes part; without extend the selection is replaced",
      "goldens run tools/blender/emulations.py::select_by_normal on the Blender side"
    ]
  }
}
