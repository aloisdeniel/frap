{
  "idname": "uv.align",
  "bl_idname": "UV_OT_align",
  "label": "Align",
  "description": "Aligns selected UV vertices on a line",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [
    {
      "identifier": "axis",
      "name": "Axis",
      "description": "Axis to align UV locations on",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "ALIGN_AUTO",
      "enum_items": [
        {
          "identifier": "ALIGN_S",
          "name": "Straighten",
          "description": "Align UV vertices along the line defined by the endpoints",
          "value": 0
        },
        {
          "identifier": "ALIGN_T",
          "name": "Straighten X",
          "description": "Align UV vertices, moving them horizontally to the line defined by the endpoints",
          "value": 1
        },
        {
          "identifier": "ALIGN_U",
          "name": "Straighten Y",
          "description": "Align UV vertices, moving them vertically to the line defined by the endpoints",
          "value": 2
        },
        {
          "identifier": "ALIGN_AUTO",
          "name": "Align Auto",
          "description": "Automatically choose the direction on which there is most alignment already",
          "value": 3
        },
        {
          "identifier": "ALIGN_X",
          "name": "Align Vertically",
          "description": "Align UV vertices on a vertical line",
          "value": 4
        },
        {
          "identifier": "ALIGN_Y",
          "name": "Align Horizontally",
          "description": "Align UV vertices on a horizontal line",
          "value": 5
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "position_mode",
      "name": "Position Mode",
      "description": "Method of calculating the alignment position",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "MEAN",
      "enum_items": [
        {
          "identifier": "MEAN",
          "name": "Mean",
          "description": "Align UVs along the mean position",
          "value": 0
        },
        {
          "identifier": "MIN",
          "name": "Minimum",
          "description": "Align UVs along the minimum position",
          "value": 1
        },
        {
          "identifier": "MAX",
          "name": "Maximum",
          "description": "Align UVs along the maximum position",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M8",
