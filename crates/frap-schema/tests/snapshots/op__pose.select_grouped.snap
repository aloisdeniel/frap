    "tier": "T0",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": [
      "COLOR: bone colours are not modelled, so every visible bone has the active bone's colour",
      "KEYINGSET always fails: keying sets are not bound (No active Keying Set to use)"
    ]
