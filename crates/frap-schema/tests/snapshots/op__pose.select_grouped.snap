{
  "idname": "pose.select_grouped",
  "bl_idname": "POSE_OT_select_grouped",
  "label": "Select Grouped",
  "description": "Select all visible bones grouped by similar properties",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_POSE"
    ],
    "text": "requires Pose Mode (bpy.ops.object.mode_set(mode='POSE'))",
    "matrix": {
      "plain": "NNNYN",
      "view3d": "NNNYN"
    }
  },
  "properties": [
    {
      "identifier": "extend",
      "name": "Extend",
      "description": "Extend selection instead of deselecting everything first",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "type",
      "name": "Type",
      "description": "",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "COLLECTION",
      "enum_items": [
        {
          "identifier": "COLLECTION",
          "name": "Collection",
          "description": "Same collections as the active bone",
          "value": 0
        },
        {
          "identifier": "COLOR",
          "name": "Color",
          "description": "Same color as the active bone",
          "value": 1
        },
        {
          "identifier": "KEYINGSET",
          "name": "Keying Set",
          "description": "All bones affected by active Keying Set",
          "value": 2
        },
        {
          "identifier": "CHILDREN",
          "name": "Children",
          "description": "Select all children of currently selected bones",
          "value": 3
        },
        {
          "identifier": "CHILDREN_IMMEDIATE",
          "name": "Immediate Children",
          "description": "Select direct children of currently selected bones",
          "value": 4
        },
        {
          "identifier": "PARENT",
          "name": "Parents",
          "description": "Select the parents of currently selected bones",
          "value": 5
        },
        {
          "identifier": "SIBLINGS",
          "name": "Siblings",
          "description": "Select all bones that have the same parent as currently selected bones",
          "value": 6
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
