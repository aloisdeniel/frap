{
  "idname": "object.shape_key_transfer",
  "bl_idname": "OBJECT_OT_shape_key_transfer",
  "label": "Transfer Shape Key",
  "description": "Copy the active shape key of another selected object to this one",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "ACTIVE_OBJECT",
      "ACTIVE_TYPE(MESH)",
      "MODE_OBJECT"
    ],
    "text": "requires an active object (bpy.context.view_layer.objects.active), the active object is of type MESH, Object Mode (bpy.ops.object.mode_set(mode='OBJECT'))",
    "matrix": {
      "plain": "YNNNN",
      "view3d": "YNNNN"
    }
  },
  "properties": [
    {
      "identifier": "mode",
      "name": "Transformation Mode",
      "description": "Relative shape positions to the new shape method",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "OFFSET",
      "enum_items": [
        {
          "identifier": "OFFSET",
          "name": "Offset",
          "description": "Apply the relative positional offset",
          "value": 0
        },
        {
          "identifier": "RELATIVE_FACE",
          "name": "Relative Face",
          "description": "Calculate relative position (using faces)",
          "value": 1
        },
        {
          "identifier": "RELATIVE_EDGE",
          "name": "Relative Edge",
          "description": "Calculate relative position (using edges)",
          "value": 2
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_clamp",
      "name": "Clamp Offset",
      "description": "Clamp the transformation to the distance each vertex moves in the original shape",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
