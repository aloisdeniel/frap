---
source: crates/frap-schema/tests/snapshots.rs
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frap:op:export_scene.gltf",
  "title": "bpy.ops.export_scene.gltf",
  "description": "Export glTF 2.0: Export scene as glTF 2.0 file",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filepath": {
      "type": "string",
      "maxLength": 1024,
      "title": "File Path",
      "description": "Filepath used for exporting the file",
      "default": ""
    },
    "check_existing": {
      "type": "boolean",
      "title": "Check Existing",
      "description": "Check and warn on overwriting existing files",
      "default": true
    },
    "export_import_convert_lighting_mode": {
      "type": "string",
      "enum": [
        "SPEC",
        "COMPAT",
        "RAW"
      ],
      "title": "Lighting Mode",
      "description": "Optional backwards compatibility for non-standard render engines. Applies to lights",
      "default": "SPEC"
    },
    "gltf_export_id": {
      "type": "string",
      "title": "Identifier",
      "description": "Identifier of caller (in case of add-on calling this exporter). Can be useful in case of Extension added by other add-ons",
      "default": ""
    },
    "export_use_gltfpack": {
      "type": "boolean",
      "title": "Use Gltfpack",
      "description": "Use gltfpack to simplify the mesh and/or compress its textures",
      "default": false
    },
    "export_gltfpack_tc": {
      "type": "boolean",
      "title": "KTX2 Compression",
      "description": "Convert all textures to KTX2 with BasisU supercompression",
      "default": true
    },
    "export_gltfpack_tq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "title": "Texture Encoding Quality",
      "description": "Texture encoding quality",
      "default": 8
    },
    "export_gltfpack_si": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "title": "Mesh Simplification Ratio",
      "description": "Simplify meshes targeting triangle count ratio",
      "default": 1
    },
    "export_gltfpack_sa": {
      "type": "boolean",
      "title": "Aggressive Mesh Simplification",
      "description": "Aggressively simplify to the target ratio disregarding quality",
      "default": false
    },
    "export_gltfpack_slb": {
      "type": "boolean",
      "title": "Lock Mesh Border Vertices",
      "description": "Lock border vertices during simplification to avoid gaps on connected meshes",
      "default": false
    },
    "export_gltfpack_vp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "title": "Position Quantization",
      "description": "Use N-bit quantization for positions",
      "default": 14
    },
    "export_gltfpack_vt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "title": "Texture Coordinate Quantization",
      "description": "Use N-bit quantization for texture coordinates",
      "default": 12
    },
    "export_gltfpack_vn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "title": "Normal/Tangent Quantization",
      "description": "Use N-bit quantization for normals and tangents",
      "default": 8
    },
    "export_gltfpack_vc": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "title": "Vertex Color Quantization",
      "description": "Use N-bit quantization for colors",
      "default": 8
    },
    "export_gltfpack_vpi": {
      "type": "string",
      "enum": [
        "Integer",
        "Normalized",
        "Floating-point"
      ],
      "title": "Vertex Position Attributes",
      "description": "Type to use for vertex position attributes",
      "default": "Integer"
    },
    "export_gltfpack_noq": {
      "type": "boolean",
      "title": "Disable Quantization",
      "description": "Disable quantization; produces much larger glTF files with no extensions",
      "default": true
    },
    "export_gltfpack_kn": {
      "type": "boolean",
      "title": "Keep Named Nodes",
      "description": "Restrict some optimization to keep named nodes and meshes attached to named nodes so that named nodes can be transformed externally",
      "default": false
    },
    "export_format": {
      "type": "string",
      "enum": [
        "GLB",
        "GLTF_SEPARATE"
      ],
      "title": "Format",
      "description": "Output format. Binary is most efficient, but JSON may be easier to edit later",
      "default": "GLB"
    },
    "ui_tab": {
      "type": "string",
      "enum": [
        "GENERAL",
        "MESHES",
        "OBJECTS",
        "ANIMATION"
      ],
      "title": "ui_tab",
      "description": "Export setting categories",
      "default": "GENERAL"
    },
    "export_copyright": {
      "type": "string",
      "title": "Copyright",
      "description": "Legal rights and conditions for the model",
      "default": ""
    },
    "export_image_format": {
      "type": "string",
      "enum": [
        "AUTO",
        "JPEG",
        "WEBP",
        "NONE"
      ],
      "title": "Images",
      "description": "Output format for images. PNG is lossless and generally preferred, but JPEG might be preferable for web applications due to the smaller file size. Alternatively they can be omitted if they are not needed",
      "default": "AUTO"
    },
    "export_image_add_webp": {
      "type": "boolean",
      "title": "Create WebP",
      "description": "Creates WebP textures for every texture. For already WebP textures, nothing happens",
      "default": false
    },
    "export_image_webp_fallback": {
      "type": "boolean",
      "title": "WebP Fallback",
      "description": "For all WebP textures, create a PNG fallback texture",
      "default": false
    },
    "export_texture_dir": {
      "type": "string",
      "title": "Textures",
      "description": "Folder to place texture files in. Relative to the .gltf file",
      "default": ""
    },
    "export_jpeg_quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "title": "JPEG Quality",
      "description": "Quality of JPEG export",
      "default": 75
    },
    "export_image_quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "title": "Image Quality",
      "description": "Quality of image export",
      "default": 75
    },
    "export_keep_originals": {
      "type": "boolean",
      "title": "Keep Original",
      "description": "Keep original textures files if possible. WARNING: if you use more than one texture, where pbr standard requires only one, only one texture will be used. This can lead to unexpected results",
      "default": false
    },
    "export_texcoords": {
      "type": "boolean",
      "title": "UVs",
      "description": "Export UVs (texture coordinates) with meshes",
      "default": true
    },
    "export_normals": {
      "type": "boolean",
      "title": "Normals",
      "description": "Export vertex normals with meshes",
      "default": true
    },
    "export_gn_mesh": {
      "type": "boolean",
      "title": "Geometry Nodes Instances (Experimental)",
      "description": "Export Geometry nodes instance meshes",
      "default": false
    },
    "export_meshopt_compression_enable": {
      "type": "boolean",
      "title": "Meshopt Compression",
      "description": "Compress mesh using Meshopt",
      "default": false
    },
    "export_meshopt_extension": {
      "type": "string",
      "enum": [
        "EXT_meshopt_compression",
        "KHR_meshopt_compression"
      ],
      "title": "Meshopt Extension",
      "description": "Extension to use for meshopt compression",
      "default": "EXT_meshopt_compression"
    },
    "export_draco_mesh_compression_enable": {
      "type": "boolean",
      "title": "Draco Mesh Compression",
      "description": "Compress mesh using Draco",
      "default": false
    },
    "export_draco_mesh_compression_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "title": "Compression Level",
      "description": "Compression level (0 = most speed, 6 = most compression, higher values currently not supported)",
      "default": 6
    },
    "export_draco_position_quantization": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "title": "Position Quantization Bits",
      "description": "Quantization bits for position values (0 = no quantization)",
      "default": 14
    },
    "export_draco_normal_quantization": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "title": "Normal Quantization Bits",
      "description": "Quantization bits for normal values (0 = no quantization)",
      "default": 10
    },
    "export_draco_texcoord_quantization": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "title": "Texcoord Quantization Bits",
      "description": "Quantization bits for texture coordinate values (0 = no quantization)",
      "default": 12
    },
    "export_draco_color_quantization": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "title": "Color Quantization Bits",
      "description": "Quantization bits for color values (0 = no quantization)",
      "default": 10
    },
    "export_draco_generic_quantization": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "title": "Generic Quantization Bits",
      "description": "Quantization bits for generic values like weights or joints (0 = no quantization)",
      "default": 12
    },
    "export_tangents": {
      "type": "boolean",
      "title": "Tangents",
      "description": "Export vertex tangents with meshes",
      "default": false
    },
    "export_materials": {
      "type": "string",
      "enum": [
        "EXPORT",
        "PLACEHOLDER",
        "VIEWPORT",
        "NONE"
      ],
      "title": "Materials",
      "description": "Export materials",
      "default": "EXPORT"
    },
    "export_unused_images": {
      "type": "boolean",
      "title": "Unused Images",
      "description": "Export images not assigned to any material",
      "default": false
    },
    "export_unused_textures": {
      "type": "boolean",
      "title": "Prepare Unused Textures",
      "description": "Export image texture nodes not assigned to any material. This feature is not standard and needs an external extension to be included in the glTF file",
      "default": false
    },
    "export_vertex_color": {
      "type": "string",
      "enum": [
        "MATERIAL",
        "ACTIVE",
        "NAME",
        "NONE"
      ],
      "title": "Use Vertex Color",
      "description": "How to export vertex color",
      "default": "MATERIAL"
    },
    "export_vertex_color_name": {
      "type": "string",
      "title": "Vertex Color Name",
      "description": "Name of vertex color to export",
      "default": "Color"
    },
    "export_all_vertex_colors": {
      "type": "boolean",
      "title": "Export All Vertex Colors",
      "description": "Export all vertex colors, even if not used by any material. If no Vertex Color is used in the mesh materials, a fake COLOR_0 will be created, in order to keep material unchanged",
      "default": true
    },
    "export_active_vertex_color_when_no_material": {
      "type": "boolean",
      "title": "Export Active Vertex Color When No Material",
      "description": "When there is no material on object, export active vertex color",
      "default": true
    },
    "export_attributes": {
      "type": "boolean",
      "title": "Attributes",
      "description": "Export Attributes (when starting with underscore)",
      "default": false
    },
    "use_mesh_edges": {
      "type": "boolean",
      "title": "Loose Edges",
      "description": "Export loose edges as lines, using the material from the first material slot",
      "default": false
    },
    "use_mesh_vertices": {
      "type": "boolean",
      "title": "Loose Points",
      "description": "Export loose points as glTF points, using the material from the first material slot",
      "default": false
    },
    "export_cameras": {
      "type": "boolean",
      "title": "Cameras",
      "description": "Export cameras",
      "default": false
    },
    "use_selection": {
      "type": "boolean",
      "title": "Selected Objects",
      "description": "Export selected objects only",
      "default": false
    },
    "use_visible": {
      "type": "boolean",
      "title": "Visible Objects",
      "description": "Export visible objects only",
      "default": false
    },
    "use_renderable": {
      "type": "boolean",
      "title": "Renderable Objects",
      "description": "Export renderable objects only",
      "default": false
    },
    "use_active_collection_with_nested": {
      "type": "boolean",
      "title": "Include Nested Collections",
      "description": "Include active collection and nested collections",
      "default": true
    },
    "use_active_collection": {
      "type": "boolean",
      "title": "Active Collection",
      "description": "Export objects in the active collection only",
      "default": false
    },
    "use_active_scene": {
      "type": "boolean",
      "title": "Active Scene",
      "description": "Export active scene only",
      "default": false
    },
    "collection": {
      "type": "string",
      "title": "Source Collection",
      "description": "Export only objects from this collection (and its children)",
      "default": ""
    },
    "at_collection_center": {
      "type": "boolean",
      "title": "Export at Collection Center",
      "description": "Export at Collection center of mass of root objects of the collection",
      "default": false
    },
    "export_extras": {
      "type": "boolean",
      "title": "Custom Properties",
      "description": "Export custom properties as glTF extras",
      "default": false
    },
    "export_yup": {
      "type": "boolean",
      "title": "+Y Up",
      "description": "Export using glTF convention, +Y up",
      "default": true
    },
    "export_apply": {
      "type": "boolean",
      "title": "Apply Modifiers",
      "description": "Apply modifiers (excluding Armatures) to mesh objects -WARNING: prevents exporting shape keys",
      "default": false
    },
    "export_shared_accessors": {
      "type": "boolean",
      "title": "Shared Accessors",
      "description": "Export Primitives using shared accessors for attributes",
      "default": false
    },
    "export_animations": {
      "type": "boolean",
      "title": "Animations",
      "description": "Exports active actions and NLA tracks as glTF animations",
      "default": true
    },
    "export_frame_range": {
      "type": "boolean",
      "title": "Limit to Playback Range",
      "description": "Clips animations to selected playback range",
      "default": false
    },
    "export_frame_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "title": "Sampling Rate",
      "description": "How often to evaluate animated values (in frames)",
      "default": 1
    },
    "export_force_sampling": {
      "type": "boolean",
      "title": "Always Sample Animations",
      "description": "Apply sampling to all animations",
      "default": true
    },
    "export_sampling_interpolation_fallback": {
      "type": "string",
      "enum": [
        "LINEAR",
        "STEP"
      ],
      "title": "Sampling Interpolation Fallback",
      "description": "Interpolation fallback for sampled animations, when the property is not keyed",
      "default": "LINEAR"
    },
    "export_pointer_animation": {
      "type": "boolean",
      "title": "Export Animation Pointer (Experimental)",
      "description": "Export material, Light & Camera animation as Animation Pointer. Available only for baked animation mode 'NLA Tracks' and 'Scene'",
      "default": false
    },
    "export_animation_mode": {
      "type": "string",
      "enum": [
        "ACTIONS",
        "ACTIVE_ACTIONS",
        "BROADCAST",
        "NLA_TRACKS",
        "SCENE"
      ],
      "title": "Animation Mode",
      "description": "Export Animation mode",
      "default": "ACTIONS"
    },
    "export_nla_strips_merged_animation_name": {
      "type": "string",
      "title": "Merged Animation Name",
      "description": "Name of single glTF animation to be exported",
      "default": "Animation"
    },
    "export_def_bones": {
      "type": "boolean",
      "title": "Export Deformation Bones Only",
      "description": "Export Deformation bones only",
      "default": false
    },
    "export_hierarchy_flatten_bones": {
      "type": "boolean",
      "title": "Flatten Bone Hierarchy",
      "description": "Flatten Bone Hierarchy. Useful in case of non decomposable transformation matrix",
      "default": false
    },
    "export_hierarchy_flatten_objs": {
      "type": "boolean",
      "title": "Flatten Object Hierarchy",
      "description": "Flatten Object Hierarchy. Useful in case of non decomposable transformation matrix",
      "default": false
    },
    "export_armature_object_remove": {
      "type": "boolean",
      "title": "Remove Armature Object",
      "description": "Remove Armature object if possible. If Armature has multiple root bones, object will not be removed",
      "default": false
    },
    "export_leaf_bone": {
      "type": "boolean",
      "title": "Add Leaf Bones",
      "description": "Append a final bone to the end of each chain to specify last bone length (use this when you intend to edit the armature from exported data)",
      "default": false
    },
    "export_optimize_animation_size": {
      "type": "boolean",
      "title": "Optimize Animation Size",
      "description": "Reduce exported file size by removing duplicate keyframes",
      "default": true
    },
    "export_optimize_animation_keep_anim_armature": {
      "type": "boolean",
      "title": "Force Keeping Channels for Bones",
      "description": "If all keyframes are identical in a rig, force keeping the minimal animation. When off, all possible channels for the bones will be exported, even if empty (minimal animation, 2 keyframes)",
      "default": true
    },
    "export_optimize_animation_keep_anim_object": {
      "type": "boolean",
      "title": "Force Keeping Channel for Objects",
      "description": "If all keyframes are identical for object transformations, force keeping the minimal animation",
      "default": false
    },
    "export_optimize_disable_viewport": {
      "type": "boolean",
      "title": "Disable Viewport for Other Objects",
      "description": "When exporting animations, disable viewport for other objects, for performance",
      "default": false
    },
    "export_negative_frame": {
      "type": "string",
      "enum": [
        "SLIDE",
        "CROP"
      ],
      "title": "Negative Frames",
      "description": "Negative Frames are slid or cropped",
      "default": "SLIDE"
    },
    "export_anim_slide_to_zero": {
      "type": "boolean",
      "title": "Set All glTF Animation Starting at 0",
      "description": "Set all glTF animation starting at 0.0s. Can be useful for looping animations",
      "default": false
    },
    "export_bake_animation": {
      "type": "boolean",
      "title": "Bake All Objects Animations",
      "description": "Force exporting animation on every object. Can be useful when using constraints or driver. Also useful when exporting only selection",
      "default": false
    },
    "export_merge_animation": {
      "type": "string",
      "enum": [
        "NLA_TRACK",
        "ACTION",
        "NONE"
      ],
      "title": "Merge Animation",
      "description": "Merge Animations",
      "default": "ACTION"
    },
    "export_anim_single_armature": {
      "type": "boolean",
      "title": "Export all Armature Actions",
      "description": "Export all actions, bound to a single armature. WARNING: Option does not support exports including multiple armatures",
      "default": true
    },
    "export_reset_pose_bones": {
      "type": "boolean",
      "title": "Reset Pose Bones Between Actions",
      "description": "Reset pose bones between each action exported. This is needed when some bones are not keyed on some animations",
      "default": true
    },
    "export_current_frame": {
      "type": "boolean",
      "title": "Use Current Frame as Object Rest Transformations",
      "description": "Export the scene in the current animation frame. When off, frame 0 is used as rest transformations for objects",
      "default": false
    },
    "export_rest_position_armature": {
      "type": "boolean",
      "title": "Use Rest Position Armature",
      "description": "Export armatures using rest position as joints' rest pose. When off, current frame pose is used as rest pose",
      "default": true
    },
    "export_anim_scene_split_object": {
      "type": "boolean",
      "title": "Split Animation by Object",
      "description": "Export Scene as seen in Viewport, But split animation by Object",
      "default": true
    },
    "export_skins": {
      "type": "boolean",
      "title": "Skinning",
      "description": "Export skinning (armature) data",
      "default": true
    },
    "export_influence_nb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "title": "Bone Influences",
      "description": "Choose how many Bone influences to export",
      "default": 4
    },
    "export_all_influences": {
      "type": "boolean",
      "title": "Include All Bone Influences",
      "description": "Allow export of all joint vertex influences. Models may appear incorrectly in many viewers",
      "default": false
    },
    "export_morph": {
      "type": "boolean",
      "title": "Shape Keys",
      "description": "Export shape keys (morph targets)",
      "default": true
    },
    "export_morph_normal": {
      "type": "boolean",
      "title": "Shape Key Normals",
      "description": "Export vertex normals with shape keys (morph targets)",
      "default": true
    },
    "export_morph_tangent": {
      "type": "boolean",
      "title": "Shape Key Tangents",
      "description": "Export vertex tangents with shape keys (morph targets)",
      "default": false
    },
    "export_morph_animation": {
      "type": "boolean",
      "title": "Shape Key Animations",
      "description": "Export shape keys animations (morph targets)",
      "default": true
    },
    "export_morph_reset_sk_data": {
      "type": "boolean",
      "title": "Reset Shape Keys Between Actions",
      "description": "Reset shape keys between each action exported. This is needed when some SK channels are not keyed on some animations",
      "default": true
    },
    "export_lights": {
      "type": "boolean",
      "title": "Punctual Lights",
      "description": "Export directional, point, and spot lights. Uses \"KHR_lights_punctual\" glTF extension",
      "default": false
    },
    "export_try_sparse_sk": {
      "type": "boolean",
      "title": "Use Sparse Accessor if Better",
      "description": "Try using Sparse Accessor if it saves space",
      "default": true
    },
    "export_try_omit_sparse_sk": {
      "type": "boolean",
      "title": "Omitting Sparse Accessor if Data is Empty",
      "description": "Omitting Sparse Accessor if data is empty",
      "default": false
    },
    "export_gpu_instances": {
      "type": "boolean",
      "title": "GPU Instances",
      "description": "Export using EXT_mesh_gpu_instancing. Limited to children of a given Empty. Multiple materials might be omitted",
      "default": false
    },
    "export_action_filter": {
      "type": "boolean",
      "title": "Filter Actions",
      "description": "Filter Actions to be exported",
      "default": false
    },
    "export_convert_animation_pointer": {
      "type": "boolean",
      "title": "Convert TRS/Weights to Animation Pointer",
      "description": "Export TRS and weights as Animation Pointer. Using KHR_animation_pointer extension",
      "default": false
    },
    "export_nla_strips": {
      "type": "boolean",
      "title": "Group by NLA Track",
      "description": "When on, multiple actions become part of the same glTF animation if they're pushed onto NLA tracks with the same name. When off, all the currently assigned actions become one glTF animation",
      "default": true
    },
    "export_original_specular": {
      "type": "boolean",
      "title": "Export Original PBR Specular",
      "description": "Export original glTF PBR Specular, instead of Blender Principled Shader Specular",
      "default": false
    },
    "will_save_settings": {
      "type": "boolean",
      "title": "Remember Export Settings",
      "description": "Store glTF export settings in the Blender project",
      "default": false
    },
    "export_hierarchy_full_collections": {
      "type": "boolean",
      "title": "Full Collection Hierarchy",
      "description": "Export full hierarchy, including intermediate collections",
      "default": false
    },
    "export_extra_animations": {
      "type": "boolean",
      "title": "Prepare Extra Animations",
      "description": "Export additional animations.\nThis feature is not standard and needs an external extension to be included in the glTF file",
      "default": false
    },
    "export_loglevel": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "title": "Log Level",
      "description": "Log Level",
      "default": -1
    },
    "filter_glob": {
      "type": "string",
      "title": "filter_glob",
      "description": "filter_glob",
      "default": "*.glb"
    }
  },
  "required": []
}
