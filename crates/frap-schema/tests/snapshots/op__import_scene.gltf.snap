      "frap_extension": false
    },
    {
      "identifier": "import_scene_extras",
      "name": "Import Scene Extras",
      "description": "Import scene extras as custom properties. Existing custom properties will be overwritten",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
