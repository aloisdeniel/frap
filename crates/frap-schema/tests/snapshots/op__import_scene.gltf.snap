    },
    {
      "identifier": "import_merge_material_slots",
      "name": "Merge Material Slot when possible",
      "description": "Merge material slots when possible",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": false,
      "skip_save": false,
      "flags": [
        "ANIMATABLE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "import_point_as_pointcloud",
      "name": "Import Points as Point Cloud",
      "description": "Import mesh with only POINTS primitives as Point Cloud objects",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": false,
