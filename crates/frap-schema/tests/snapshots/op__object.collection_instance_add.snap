    },
    {
      "identifier": "drop_y",
      "name": "Drop Y",
      "description": "Y-coordinate (screen space) to place the new object under",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 0,
      "hard_min": -2147483648,
      "hard_max": 2147483647,
      "soft_min": -2147483648,
      "soft_max": 2147483647,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T0",
    "support": "partial",
    "support_note": "drop_x/drop_y (placement under the mouse) answer OP_NOT_IMPLEMENTED: the virtual 3D View has no region",
    "headless": "native",
    "planned": "M8",
    "extension": false,
    "notes": [
      "the collection comes from session_uid, else name (when passed), else the collection enum",
      "the instance goes to the closest visible ancestor of the active collection when that one is part of the instanced collection (the active collection moves there)"
    ]
  }
}
