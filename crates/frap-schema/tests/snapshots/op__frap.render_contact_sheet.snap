{
  "idname": "frap.render_contact_sheet",
  "bl_idname": "FRAP_OT_render_contact_sheet",
  "label": "Render Contact Sheet",
  "description": "Render the scene from several views into one labelled image (frap extension; synthetic cameras never enter bpy.data)",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": null
  },
  "properties": [
    {
      "identifier": "filepath",
      "name": "File Path",
      "description": "Output image (// = relative to the .frap file, else the working directory)",
      "type": "STRING",
      "subtype": "FILE_PATH",
      "unit": "NONE",
      "array": null,
      "default": "//sheet.png",
      "length_max": 1024,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    },
    {
      "identifier": "views",
      "name": "Views",
      "description": "Views to render; tiles follow the item order FRONT, BACK, RIGHT, LEFT, TOP, BOTTOM, ISO, CAMERA",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": [
        "FRONT",
        "ISO",
        "RIGHT",
        "TOP"
      ],
      "enum_items": [
        {
          "identifier": "FRONT",
          "name": "Front",
          "description": "Looking along +Y (numpad 1)",
          "value": 1
        },
        {
          "identifier": "BACK",
          "name": "Back",
          "description": "Looking along -Y (Ctrl numpad 1)",
          "value": 2
        },
        {
          "identifier": "RIGHT",
          "name": "Right",
          "description": "Looking along -X (numpad 3)",
          "value": 4
        },
        {
          "identifier": "LEFT",
          "name": "Left",
          "description": "Looking along +X (Ctrl numpad 3)",
          "value": 8
        },
        {
          "identifier": "TOP",
          "name": "Top",
          "description": "Looking along -Z (numpad 7)",
          "value": 16
        },
        {
          "identifier": "BOTTOM",
          "name": "Bottom",
          "description": "Looking along +Z (Ctrl numpad 7)",
          "value": 32
        },
        {
          "identifier": "ISO",
          "name": "Iso",
          "description": "The factory viewport rotation",
          "value": 64
        },
        {
          "identifier": "CAMERA",
          "name": "Camera",
          "description": "The scene camera",
          "value": 128
        }
      ],
      "is_enum_flag": true,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE",
        "ENUM_FLAG"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    },
    {
      "identifier": "engine",
      "name": "Engine",
      "description": "Render engine of the tiles",
      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "BLENDER_WORKBENCH",
      "enum_items": [
        {
          "identifier": "BLENDER_WORKBENCH",
          "name": "Workbench",
          "description": "Workbench",
          "value": 0
        },
        {
          "identifier": "BLENDER_EEVEE",
          "name": "EEVEE",
          "description": "EEVEE (Workbench with a WARNING until M5)",
          "value": 1
        }
      ],
      "is_enum_flag": false,
      "dynamic_enum": null,
      "context_rule": null,
      "hidden": false,
      "skip_save": true,
