      "type": "ENUM",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "VISIBLE",
      "enum_items": [
        {
          "identifier": "VISIBLE",
          "name": "Visible",
          "description": "Visible renderable objects",
          "value": 0
