      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": false,
      "skip_save": true,
      "flags": [
        "SKIP_SAVE"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": true
    },
    {
      "identifier": "frame",
      "name": "Frame",
      "description": "Frame to render (omit it to render the current frame)",
      "type": "INT",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": 0,
      "hard_min": -2147483648,
      "hard_max": 2147483647,
      "soft_min": -2147483648,
      "soft_max": 2147483647,
      "hidden": false,
      "skip_save": true,
