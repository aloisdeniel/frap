    "status": "implemented",
    "tier": "T0",
    "support": "partial",
    "support_note": "meshes only: armatures arrive in M6; meshes with shape keys or with one attribute name stored with two domains/types answer OP_NOT_IMPLEMENTED",
    "headless": "native",
    "planned": "M1",
    "extension": false,
    "notes": [
      "CANCELLED with Blender's WARNING reports when the active object is not a selected mesh or nothing would be joined"
    ]
  }
