{
  "idname": "mesh.edge_collapse",
  "bl_idname": "MESH_OT_edge_collapse",
  "label": "Collapse Edges & Faces",
  "description": "Collapse isolated edge and face regions, merging data such as UVs and color attributes. This can collapse edge-rings as well as regions of connected faces into vertices",
  "bl_options": [
    "REGISTER",
    "UNDO"
  ],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [
      "MODE_EDIT_MESH"
    ],
    "text": "requires Edit Mode on a mesh (bpy.ops.object.mode_set(mode='EDIT') with a mesh active)",
    "matrix": {
      "plain": "NNYNN",
      "view3d": "NNYNN"
    }
  },
  "properties": [],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M2",
    "extension": false,
    "notes": [
      "each connected group of selected edges collapses to one vertex at the mean of its edges' endpoints"
    ]
  }
}
