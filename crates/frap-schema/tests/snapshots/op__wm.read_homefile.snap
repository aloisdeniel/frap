{
  "idname": "wm.read_homefile",
  "bl_idname": "WM_OT_read_homefile",
  "label": "Reload Start-Up File",
  "description": "Open the default file",
  "bl_options": [],
  "kind": "NORMAL",
  "macro_steps": [],
  "poll": {
    "requires": [],
    "text": "always available",
    "matrix": {
      "plain": "YYYYY",
      "view3d": "YYYYY"
    }
  },
  "properties": [
    {
      "identifier": "filepath",
      "name": "File Path",
      "description": "Path to an alternative start-up file",
      "type": "STRING",
      "subtype": "FILE_PATH",
      "unit": "NONE",
      "array": null,
      "default": "",
      "length_max": 1024,
      "hidden": true,
      "skip_save": false,
      "flags": [
        "HIDDEN",
        "NEVER_NULL",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "load_ui",
      "name": "Load UI",
      "description": "Load user interface setup from the .blend file",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": true,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_splash",
      "name": "Splash",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_factory_startup",
      "name": "Factory Startup",
      "description": "Load the default ('factory startup') blend file. This is independent of the normal start-up file that the user can save",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_factory_startup_app_template_only",
      "name": "Factory Startup App-Template Only",
      "description": "",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "app_template",
      "name": "",
      "description": "",
      "type": "STRING",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": "Template",
      "length_max": 64,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "NEVER_NULL",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    },
    {
      "identifier": "use_empty",
      "name": "Empty",
      "description": "After loading, remove everything except scenes, windows, and workspaces. This makes it possible to load the startup file with its scene configuration and window layout intact, but no objects, materials, animations, ...",
      "type": "BOOLEAN",
      "subtype": "NONE",
      "unit": "NONE",
      "array": null,
      "default": false,
      "hidden": true,
      "skip_save": true,
      "flags": [
        "HIDDEN",
        "SKIP_SAVE",
        "ANIMATABLE",
        "SKIP_PRESET"
      ],
      "required": false,
      "unset_semantics": null,
      "frap_note": null,
      "frap_extension": false
    }
  ],
  "frap": {
    "status": "implemented",
    "tier": "T1",
    "support": "full",
    "support_note": null,
    "headless": "native",
    "planned": "M1",
    "extension": false,
    "notes": [
      "the home file is always the factory startup (frap has no user startup file)",
      "filepath loads a .frap as the startup state",
      "load_ui, use_splash and app_template are accepted and ignored with an INFO report"
    ]
  }
}
