    },
    {
      "identifier": "offset",
      "name": "Stroke Offset",
      "description": "Offset strokes from fill",
      "type": "FLOAT",
      "subtype": "DISTANCE",
      "unit": "LENGTH",
      "array": null,
      "default": 0.01,
      "hard_min": 0,
      "hard_max": 1000000000000,
      "soft_min": 0,
      "soft_max": 100,
      "precision": 3,
      "hidden": false,
      "skip_save": false,
